@page "/admin/roles"
@attribute [Authorize(Policy = PlatformPermissions.RolesManage)]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory
@inject ISnackbar Snackbar

<PageTitle>Roles &amp; Permissions</PageTitle>

<div class="d-flex align-center mb-4 flex-wrap gap-2">
    <MudText Typo="Typo.h5">Roles &amp; Permissions</MudText>
    <MudSpacer />
    <MudSelect T="string" @bind-Value="_moduleKey" Label="App" Margin="Margin.Dense"
               Style="width:220px" ToStringFunc="@ModuleName">
        @foreach (var m in _moduleKeys)
        {
            <MudSelectItem Value="@m">@ModuleName(m)</MudSelectItem>
        }
    </MudSelect>
</div>

<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    A role belongs to one app. Holding it both admits the user to that app's tile on
    the portal and decides what they can do inside it. Changes take effect when the
    user next signs in.
</MudText>

<div class="d-flex align-end mb-4 gap-2">
    <MudTextField @bind-Value="_newRole" Label="@($"New {ModuleName(_moduleKey)} role")"
                  Margin="Margin.Dense" Immediate="true" Style="width:260px" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddRole"
               Disabled="@(string.IsNullOrWhiteSpace(_newRole))">Add Role</MudButton>
</div>

@{
    var roles = _roles.Where(r => r.ModuleKey == _moduleKey).OrderBy(r => r.Name).ToList();
    var permissions = PermissionCatalog.ForModule(_moduleKey);
}

@if (permissions.Count == 0)
{
    <MudAlert Severity="Severity.Info">This app hasn't registered any permissions.</MudAlert>
}
else if (roles.Count == 0)
{
    <MudAlert Severity="Severity.Info">No roles defined for this app yet. Add one above.</MudAlert>
}
else
{
    <MudPaper Class="pa-2" Style="overflow-x:auto">
        <table style="border-collapse:collapse;min-width:900px">
            <thead>
                <tr>
                    <th style="text-align:left;padding:8px;position:sticky;left:0;background:var(--mud-palette-surface)">
                        Permission
                    </th>
                    @foreach (var role in roles)
                    {
                        <th style="padding:8px;writing-mode:vertical-rl;transform:rotate(180deg);white-space:nowrap">
                            @role.Name
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var group in permissions.GroupBy(p => p.Group))
                {
                    <tr>
                        <td colspan="@(roles.Count + 1)" style="padding:8px;font-weight:700">@group.Key</td>
                    </tr>
                    @foreach (var perm in group)
                    {
                        <tr>
                            <td style="padding:4px 8px;position:sticky;left:0;background:var(--mud-palette-surface)"
                                title="@perm.Name">
                                @perm.Description
                            </td>
                            @foreach (var role in roles)
                            {
                                var roleName = role.Name!;
                                var permName = perm.Name;
                                <td style="text-align:center">
                                    <MudCheckBox T="bool" Dense="true"
                                                 Value="@(_matrix.Contains((roleName, permName)))"
                                                 ValueChanged="@(v => Toggle(roleName, permName, v))" />
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </MudPaper>
}

@code {
    private List<ApplicationRole> _roles = [];
    private HashSet<(string Role, string Permission)> _matrix = [];
    private List<string> _moduleKeys = [];
    private string _moduleKey = PlatformPermissions.ModuleKey;
    private string _newRole = "";

    protected override Task OnInitializedAsync()
    {
        // The platform's own permissions are edited alongside each app's.
        _moduleKeys = [PlatformPermissions.ModuleKey, .. AppModules.All.Select(m => m.Key)];
        return LoadAsync();
    }

    private static string ModuleName(string key) =>
        key == PlatformPermissions.ModuleKey ? "Platform" : AppModules.Find(key)?.Name ?? key;

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var roleManager = scope.ServiceProvider.GetRequiredService<RoleManager<ApplicationRole>>();
        _roles = await roleManager.Roles.OrderBy(r => r.Name).ToListAsync();

        // Platform-wide roles have no module key; show them under "Platform".
        foreach (var r in _roles.Where(r => r.ModuleKey is null))
            r.ModuleKey = PlatformPermissions.ModuleKey;

        _matrix = [];
        foreach (var role in _roles)
            foreach (var c in (await roleManager.GetClaimsAsync(role))
                         .Where(c => c.Type == PermissionCatalog.ClaimType))
                _matrix.Add((role.Name!, c.Value));

        StateHasChanged();
    }

    private async Task Toggle(string roleName, string permission, bool granted)
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var roleManager = scope.ServiceProvider.GetRequiredService<RoleManager<ApplicationRole>>();
            var role = await roleManager.FindByNameAsync(roleName);
            if (role is null) return;

            var claim = new Claim(PermissionCatalog.ClaimType, permission);
            if (granted)
            {
                await roleManager.AddClaimAsync(role, claim);
                _matrix.Add((roleName, permission));
            }
            else
            {
                await roleManager.RemoveClaimAsync(role, claim);
                _matrix.Remove((roleName, permission));
            }

            Snackbar.Add($"{roleName}: {permission} {(granted ? "granted" : "revoked")}. " +
                         "Users pick this up at their next sign-in.", Severity.Info);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task AddRole()
    {
        if (string.IsNullOrWhiteSpace(_newRole)) return;
        using var scope = ScopeFactory.CreateScope();
        var roleManager = scope.ServiceProvider.GetRequiredService<RoleManager<ApplicationRole>>();

        // A platform role is deliberately unscoped (null), not scoped to "platform".
        var moduleKey = _moduleKey == PlatformPermissions.ModuleKey ? null : _moduleKey;
        var result = await roleManager.CreateAsync(new ApplicationRole(_newRole.Trim(), moduleKey));

        if (result.Succeeded)
        {
            Snackbar.Add("Role created.", Severity.Success);
            _newRole = "";
            await LoadAsync();
        }
        else
        {
            Snackbar.Add(string.Join("; ", result.Errors.Select(e => e.Description)), Severity.Error);
        }
    }
}
