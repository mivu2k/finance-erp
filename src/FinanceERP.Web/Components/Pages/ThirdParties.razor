@page "/finance/third-parties"
@attribute [Authorize(Policy = Permissions.ThirdPartiesView)]
@inject IServiceScopeFactory ScopeFactory
@inject ISnackbar Snackbar

<PageTitle>Third Parties</PageTitle>

<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h5">Third Parties</MudText>
    <MudSpacer />
    <AuthorizeView Policy="@Permissions.ThirdPartiesManage">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => _editing = new ThirdParty())">New Third Party</MudButton>
    </AuthorizeView>
</div>

<MudPaper Class="pa-4 mb-4">
    <MudTextField @bind-Value="_search" Label="Search by name or phone" Immediate="true"
                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                  OnAdornmentClick="@(() => _table!.ReloadServerData())" />
</MudPaper>

@* Which heads all this money actually moved through, across every party. The common
   case this answers: money taken from a party lands in cash in hand, gets spent on
   other heads, and is paid back later. *@
<MudExpansionPanels Class="mb-4" Elevation="1">
    <MudExpansionPanel Text="@($"Money by head ({_headTotals.Count})")" Expanded="false">
        @if (_headTotals.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Nothing posted against a third party yet.
            </MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Striped="true" Style="overflow-x:auto">
                <thead>
                    <tr>
                        <th>Head</th>
                        <th style="text-align:right">Received into</th>
                        <th style="text-align:right">Paid out of</th>
                        <th style="text-align:right">Net</th>
                        <th style="text-align:right">Movements</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in _headTotals)
                    {
                        <tr>
                            <td><span class="mud-text-secondary">@h.Code</span> @h.Name</td>
                            <td style="text-align:right">@(h.Received == 0 ? "" : h.Received.ToString("N2"))</td>
                            <td style="text-align:right">@(h.Paid == 0 ? "" : h.Paid.ToString("N2"))</td>
                            <td style="text-align:right">@h.Net.ToString("N2")</td>
                            <td style="text-align:right">@h.Movements</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudExpansionPanel>
</MudExpansionPanels>

<MudTable @ref="_table" T="ThirdParty" ServerData="LoadData" Dense="true" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh>Name</MudTh><MudTh>Side</MudTh><MudTh>Phone</MudTh><MudTh>Email</MudTh>
        <MudTh>Tax No</MudTh><MudTh Style="text-align:right">Balance</MudTh><MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small"
                     Color="@(context.Type == ThirdPartyType.Receivable ? Color.Success : Color.Error)">
                @(context.Type == ThirdPartyType.Receivable ? "They owe us" : "We owe them")
            </MudChip>
        </MudTd>
        <MudTd>@context.Phone</MudTd>
        <MudTd>@context.Email</MudTd>
        <MudTd>@context.TaxNumber</MudTd>
        <MudTd Style="text-align:right">@(_balances.TryGetValue(context.Id, out var b) ? b.ToString("N2") : "—")</MudTd>
        <MudTd Style="white-space:nowrap">
            @if (context.AccountId is not null)
            {
                <MudTooltip Text="View statement">
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.MenuBook"
                                   Href="@($"/finance/third-parties/{context.Id}")" />
                </MudTooltip>
                <AuthorizeView Policy="@Permissions.ReportsExport" Context="x">
                    <MudTooltip Text="Statement PDF (last 12 months)">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.PictureAsPdf"
                                       Href="@($"/export/ledger?format=pdf&accountId={context.AccountId}&from={DateOnly.FromDateTime(DateTime.Today.AddYears(-1)):yyyy-MM-dd}&to={DateOnly.FromDateTime(DateTime.Today):yyyy-MM-dd}")"
                                       Target="_blank" />
                    </MudTooltip>
                </AuthorizeView>
            }
            @if (context.AccountId is not null)
            {
                <AuthorizeView Policy="@Permissions.VouchersCreate" Context="r">
                    @* One labelled button; which way the money runs is chosen in the
                       dialog, where there is room to say what each direction means. *@
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Payments"
                               OnClick="@(() => OpenRecord(context))">Add payment</MudButton>
                </AuthorizeView>
                <MudTooltip Text="Open this party">
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.OpenInNew"
                                   Href="@($"/finance/third-parties/{context.Id}")" />
                </MudTooltip>
            }
            <AuthorizeView Policy="@Permissions.ThirdPartiesManage" Context="m">
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit" OnClick="@(() => _editing = context)" />
            </AuthorizeView>
        </MudTd>
    </RowTemplate>
    <PagerContent><MudTablePager /></PagerContent>
</MudTable>

@if (_editing is not null)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Class="pa-6" Style="width:480px;max-width:95vw">
            <MudText Typo="Typo.h6" Class="mb-3">@(_editing.Id == 0 ? "New Third Party" : _editing.Name)</MudText>
            <MudTextField @bind-Value="_editing.Name" Label="Name" Class="mb-2" />
            <MudSelect T="ThirdPartyType" @bind-Value="_editing.Type" Class="mb-2"
                       Label="Which way does the money run?"
                       HelperText="@(_editing.Id == 0 ? "Decides whether their account sits under Receivables or Payables" : "Changing this doesn't move an account already created")">
                <MudSelectItem Value="@ThirdPartyType.Receivable">They owe us — receivable</MudSelectItem>
                <MudSelectItem Value="@ThirdPartyType.Payable">We owe them — payable</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_editing.Phone" Label="Phone" Class="mb-2" />
            <MudTextField @bind-Value="_editing.Email" Label="Email" Class="mb-2" />
            <MudTextField @bind-Value="_editing.Address" Label="Address" Class="mb-2" />
            <MudTextField @bind-Value="_editing.TaxNumber" Label="NTN / Tax Number" Class="mb-2" />
            <MudTextField @bind-Value="_editing.Notes" Label="Notes" Lines="2" Class="mb-2" />
            <div class="d-flex justify-end gap-2 mt-4">
                <MudButton OnClick="@(() => _editing = null)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

<PartyPaymentDialog Party="_recordParty" Balance="@RecordBalance" Heads="_cashAccounts"
                    OnClosed="@(() => _recordParty = null)" OnPosted="ReloadAsync" />

@code {
    private MudTable<ThirdParty>? _table;
    private string _search = "";
    private ThirdParty? _editing;
    private Dictionary<int, decimal> _balances = [];
    private List<PartyHeadTotalDto> _headTotals = [];

    private ThirdParty? _recordParty;
    private List<Account> _cashAccounts = [];

    /// <summary>Their outstanding figure, handed to the dialog so it can show the effect.</summary>
    private decimal RecordBalance =>
        _recordParty is not null && _balances.TryGetValue(_recordParty.Id, out var b) ? b : 0m;

    private void OpenRecord(ThirdParty party) => _recordParty = party;

    private async Task ReloadAsync()
    {
        if (_table is not null) await _table.ReloadServerData();
    }

    private async Task<TableData<ThirdParty>> LoadData(TableState state, CancellationToken ct)
    {
        using var scope = ScopeFactory.CreateScope();
        var result = await scope.ServiceProvider.GetRequiredService<IThirdPartyService>()
            .ListAsync(new ReportFilter { Search = _search, Page = state.Page + 1, PageSize = state.PageSize });
        var accounts = scope.ServiceProvider.GetRequiredService<IAccountService>();

        // Cash, bank and petty cash (1100 / 12xx / 1300) are the only sensible other
        // side of these postings, and GetPostableAsync has already dropped the
        // non-postable parent headings like 1200 Bank Accounts.
        if (_cashAccounts.Count == 0)
            _cashAccounts = (await accounts.GetPostableAsync())
                .Where(a => a.Type == AccountType.Asset
                            && (a.Code.StartsWith("11") || a.Code.StartsWith("12")
                                || a.Code.StartsWith("13")))
                .OrderBy(a => a.Code).ToList();

        _balances = [];
        foreach (var tp in result.Items.Where(t => t.AccountId is not null))
            _balances[tp.Id] = await accounts.GetBalanceAsync(tp.AccountId!.Value);

        _headTotals = await scope.ServiceProvider.GetRequiredService<IThirdPartyService>()
            .GetHeadTotalsAsync();

        return new TableData<ThirdParty> { Items = result.Items, TotalItems = result.TotalCount };
    }

    private async Task Save()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<IThirdPartyService>().SaveAsync(_editing!);
            Snackbar.Add("Third party saved (ledger account auto-created).", Severity.Success);
            _editing = null;
            await _table!.ReloadServerData();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
