@inherits LayoutComponentBase

@* Finance's chrome is the platform shell plus this app's nav, search and alerts. *@
<PlatformShell Title="MEI Ledger" Accent="#1565C0">
    <Toolbar>
        <AuthorizeView Policy="@FinanceERP.Domain.Security.Permissions.LedgerView">
            <GlobalSearch />
        </AuthorizeView>
        <NotificationBell />
    </Toolbar>
    <Nav>
        <NavMenu />
    </Nav>
    <ChildContent>
        @Body
    </ChildContent>
</PlatformShell>
