@page "/ledger/settings"
@attribute [Authorize(Policy = LedgerPermissions.FinanceLink)]
@layout LedgerLayout
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject ISnackbar Snackbar

<PageTitle>Ledger Settings</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Accounting Link</MudText>

<MudPaper Class="pa-4" MaxWidth="720px">
    @if (!_available)
    {
        <MudAlert Severity="Severity.Info">
            The accounting module isn't wired into this installation, so plain ledgers stay
            purely informal. Nothing here applies until Finance is available.
        </MudAlert>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
            Entries on a ledger reach the real books only when two things are set: this cash
            account, and an account on the ledger itself. Every posting has cash on one side —
            money physically arriving or leaving — and the ledger's own account on the other.
            Leave this empty and the whole module stays out of the trial balance.
        </MudText>

        <MudSelect T="int?" @bind-Value="_cashAccountId" Label="Cash / bank account"
                   Clearable="true" Margin="Margin.Dense"
                   HelperText="The account representing money you physically hold">
            @foreach (var a in _accounts)
            {
                <MudSelectItem T="int?" Value="@a.Id">@a.Code — @a.Name</MudSelectItem>
            }
        </MudSelect>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Class="mt-4">
            Save
        </MudButton>

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">How entries post</MudText>
        <MudSimpleTable Dense="true">
            <thead><tr><th>Ledger type</th><th>Entry</th><th>Debit</th><th>Credit</th></tr></thead>
            <tbody>
                <tr><td>Payable — you took their money</td><td>In</td><td>Cash</td><td>Their account</td></tr>
                <tr><td>Payable</td><td>Out — you paid them back</td><td>Their account</td><td>Cash</td></tr>
                <tr><td>Receivable — you gave them money</td><td>In</td><td>Their account</td><td>Cash</td></tr>
                <tr><td>Receivable</td><td>Out — they returned it</td><td>Cash</td><td>Their account</td></tr>
            </tbody>
        </MudSimpleTable>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2 d-block">
            A transfer posts once, on the receiving side only — the cash moves a single time,
            and what you do with money after taking it doesn't change what you owe for it.
        </MudText>
    }
</MudPaper>

@code {
    private bool _available;
    private IReadOnlyList<BookkeepingAccount> _accounts = [];
    private int? _cashAccountId;

    protected override async Task OnInitializedAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var settings = scope.ServiceProvider.GetRequiredService<ILedgerSettingsService>();

        _available = settings.PostingAvailable;
        if (!_available) return;

        _accounts = await settings.ListAccountsAsync();
        _cashAccountId = await settings.GetCashAccountIdAsync();
    }

    private async Task Save()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ILedgerSettingsService>()
                .SetCashAccountIdAsync(_cashAccountId);
            Snackbar.Add("Saved.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
