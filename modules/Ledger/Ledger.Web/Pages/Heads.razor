@page "/ledger/heads"
@attribute [Authorize(Policy = LedgerPermissions.View)]
@layout LedgerLayout
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject ISnackbar Snackbar

<PageTitle>Ledger Heads</PageTitle>

<div class="d-flex align-center mb-4 flex-wrap gap-2">
    <MudText Typo="Typo.h5">Heads</MudText>
    <MudSpacer />
    <AuthorizeView Policy="@LedgerPermissions.HeadsManage">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AddBox" OnClick="@(() => OpenEditor(null))">
            New Head
        </MudButton>
    </AuthorizeView>
</div>

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
    These are this module's own heads — nothing to do with the accounting chart of
    accounts. A head can hold sub-heads, and a parent's totals include everything
    underneath it. Both a whole book and an individual entry can be filed under one.
</MudAlert>

<MudPaper Class="pa-2" Style="overflow-x:auto">
    <MudSimpleTable Dense="true" Hover="true">
        <thead>
            <tr>
                <th>Head</th><th>Code</th><th>Ledgers</th><th>Entries</th>
                <th style="text-align:right">In</th><th style="text-align:right">Out</th>
                <th style="text-align:right">Net (with sub-heads)</th>
                <th style="width:96px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var node in Flatten(_roots))
            {
                var t = _totals.GetValueOrDefault(node.Head.Id);
                <tr>
                    <td>
                        <div style="@($"padding-left:{node.Depth * 22}px")" class="d-flex align-center gap-1">
                            @if (node.Depth > 0)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight"
                                         Size="Size.Small" Class="mud-text-secondary" />
                            }
                            @node.Head.Name
                            @if (!node.Head.IsActive)
                            {
                                <MudChip T="string" Size="Size.Small">Inactive</MudChip>
                            }
                        </div>
                    </td>
                    <td>@node.Head.Code</td>
                    <td>@(t?.LedgerCount ?? 0)</td>
                    <td>@(t?.OwnEntryCount ?? 0)</td>
                    <td style="text-align:right">@((t?.OwnIn ?? 0).ToString("N2"))</td>
                    <td style="text-align:right">@((t?.OwnOut ?? 0).ToString("N2"))</td>
                    <td style="text-align:right">
                        <b>@(((t?.RollupIn ?? 0) - (t?.RollupOut ?? 0)).ToString("N2"))</b>
                    </td>
                    <td>
                        <AuthorizeView Policy="@LedgerPermissions.HeadsManage" Context="hm">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                           OnClick="@(() => OpenEditor(node.Head))" />
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error" OnClick="@(() => _delete = node.Head)" />
                        </AuthorizeView>
                    </td>
                </tr>
            }
            @if (_roots.Count == 0)
            {
                <tr><td colspan="8" class="mud-text-secondary pa-4">
                    No heads yet. Add a few — "Loans Taken", "Advances Given", "Expenses" —
                    then file books and entries under them.
                </td></tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@if (_edit is not null)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Class="pa-6" Style="width:500px;max-width:95vw">
            <MudText Typo="Typo.h6" Class="mb-3">@(_edit.Id == 0 ? "New Head" : "Edit Head")</MudText>
            <MudTextField @bind-Value="_edit.Name" Label="Name" Class="mb-2" />
            <MudTextField @bind-Value="_edit.Code" Label="Code" Class="mb-2" />
            <MudSelect T="int?" @bind-Value="_edit.ParentHeadId" Label="Under (parent head)"
                       Clearable="true" Class="mb-2" HelperText="Leave empty for a top-level head">
                @foreach (var h in _all.Where(h => h.Id != _edit.Id))
                {
                    <MudSelectItem T="int?" Value="@h.Id">@h.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_edit.Notes" Label="Notes" Lines="2" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_edit.IsActive" Label="Active" Color="Color.Primary" />
            <div class="d-flex justify-end gap-2 mt-4">
                <MudButton OnClick="@(() => _edit = null)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@if (_delete is not null)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Class="pa-6" Style="width:480px;max-width:95vw">
            <MudText Typo="Typo.h6" Class="mb-2">Delete @_delete.Name?</MudText>
            <MudText Typo="Typo.body2" Class="mb-4">
                Only possible while it has no sub-heads. Books and entries filed under it
                keep their money and simply read as unclassified afterwards.
            </MudText>
            <div class="d-flex justify-end gap-2">
                <MudButton OnClick="@(() => _delete = null)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Delete">Delete</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@code {
    private List<HeadNode> _roots = [];
    private List<LedgerHead> _all = [];
    private Dictionary<int, HeadTotals> _totals = [];
    private LedgerHead? _edit;
    private LedgerHead? _delete;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var svc = scope.ServiceProvider.GetRequiredService<ILedgerHeadService>();
        _roots = await svc.GetTreeAsync();
        _all = await svc.ListAsync();
        _totals = await svc.GetTotalsAsync();
        StateHasChanged();
    }

    private static IEnumerable<HeadNode> Flatten(IEnumerable<HeadNode> nodes)
    {
        foreach (var n in nodes)
        {
            yield return n;
            foreach (var c in Flatten(n.Children)) yield return c;
        }
    }

    // Edit a copy so cancelling leaves the table untouched.
    private void OpenEditor(LedgerHead? head) => _edit = head is null
        ? new LedgerHead()
        : new LedgerHead
        {
            Id = head.Id, Name = head.Name, Code = head.Code,
            ParentHeadId = head.ParentHeadId, Notes = head.Notes, IsActive = head.IsActive
        };

    private async Task Save()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ILedgerHeadService>().SaveAsync(_edit!);
            _edit = null;
            Snackbar.Add("Head saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Delete()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ILedgerHeadService>()
                .DeleteAsync(_delete!.Id);
            _delete = null;
            Snackbar.Add("Head deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _delete = null;
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
