                @_tender?.TenderNumber and its guarantees and documents will be removed.
            </MudText>
            <div class="d-flex justify-end gap-2">
                <MudButton OnClick="@(() => _confirmDeleteTender = false)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteTenderAsync">Delete</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@if (_deleteGuarantee is not null)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
