@code {
    [Parameter] public int Id { get; set; }

    private TenderRecord? _tender;

    private TenderGuarantee? _guaranteeForm;
    private int? _editingGuaranteeId;
    private DateTime? _guaranteeIssueDate, _guaranteeExpiryDate, _guaranteeClaimPeriodEndDate, _guaranteeReleaseDate;
    private TenderGuarantee? _deleteGuarantee;
    private List<TenderGuarantee> _renewableGuarantees = [];

    private TenderDocument? _documentForm;
    private int? _editingDocumentId;
    private DateTime? _documentDate;
    private TenderDocument? _deleteDocument;

    private TenderCompetitor? _competitorForm;
    private int? _editingCompetitorId;
    private TenderCompetitor? _deleteCompetitor;

    private TenderItem? _itemForm;
    private int? _editingItemId;
    private int? _confirmDeleteItemId;

    private IReadOnlyList<PlatformUser> _users = [];

    private bool _confirmDeleteTender;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        _tender = await scope.ServiceProvider.GetRequiredService<ITenderService>().GetAsync(Id);
        _renewableGuarantees = _tender?.Guarantees.ToList() ?? [];
        _users = await scope.ServiceProvider.GetRequiredService<IPlatformUserDirectory>()
            .ListForModuleAsync(AppModules.Tender);
        StateHasChanged();
    }

    // ---- schedule items ----

    private void OpenItem(TenderItem? item)
    {
        _editingItemId = item?.Id;
        _itemForm = item is null
            ? new TenderItem()
            : new TenderItem
            {
                Id = item.Id, TenderRecordId = item.TenderRecordId,
                ItemCode = item.ItemCode, Description = item.Description,
                Specification = item.Specification, Unit = item.Unit,
                Quantity = item.Quantity, UnitRate = item.UnitRate,
                EstimatedRate = item.EstimatedRate, CostRate = item.CostRate,
                Brand = item.Brand, CountryOfOrigin = item.CountryOfOrigin,
                DeliveryDays = item.DeliveryDays, SortOrder = item.SortOrder,
                Remarks = item.Remarks
            };
    }

    private async Task SaveItemAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var svc = scope.ServiceProvider.GetRequiredService<ITenderService>();

            if (_editingItemId is null) await svc.AddItemAsync(Id, _itemForm!);
            else await svc.UpdateItemAsync(_itemForm!);

            _itemForm = null;
            Snackbar.Add("Item saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteItemAsync()
    {
        if (_confirmDeleteItemId is not { } itemId) return;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ITenderService>().DeleteItemAsync(itemId);
            _confirmDeleteItemId = null;
            Snackbar.Add("Item deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static Color StatusColor(TenderStatus status) => status switch
    {
        TenderStatus.Won => Color.Success,
        TenderStatus.Lost or TenderStatus.Cancelled or TenderStatus.Withdrawn => Color.Error,
        TenderStatus.Submitted or TenderStatus.TechnicallyQualified => Color.Info,
        _ => Color.Default
    };

    private static Color GuaranteeStatusColor(GuaranteeStatus status) => status switch
    {
        GuaranteeStatus.Active => Color.Success,
        GuaranteeStatus.Invoked => Color.Error,
        GuaranteeStatus.Expired => Color.Warning,
        _ => Color.Default
    };

    // --- guarantees ---

    private void OpenGuaranteeEditor(TenderGuarantee? g)
    {
        _editingGuaranteeId = g?.Id;
        _guaranteeForm = g is null
            ? new TenderGuarantee { IssueDate = DateOnly.FromDateTime(DateTime.Today), ExpiryDate = DateOnly.FromDateTime(DateTime.Today) }
            : new TenderGuarantee
            {
                Id = g.Id, TenderRecordId = g.TenderRecordId, Type = g.Type, InstrumentType = g.InstrumentType,
                BankName = g.BankName, BranchName = g.BranchName,
                BankContactPerson = g.BankContactPerson, BankContactPhone = g.BankContactPhone,
                GuaranteeNumber = g.GuaranteeNumber, Amount = g.Amount, Charges = g.Charges,
                IssueDate = g.IssueDate, ExpiryDate = g.ExpiryDate, ClaimPeriodEndDate = g.ClaimPeriodEndDate,
                Status = g.Status, ReleaseDate = g.ReleaseDate, ReleaseReference = g.ReleaseReference,
                Remarks = g.Remarks, RenewalOfGuaranteeId = g.RenewalOfGuaranteeId
            };

        _guaranteeIssueDate = _guaranteeForm.IssueDate.ToDateTime(TimeOnly.MinValue);
        _guaranteeExpiryDate = _guaranteeForm.ExpiryDate.ToDateTime(TimeOnly.MinValue);
        _guaranteeClaimPeriodEndDate = _guaranteeForm.ClaimPeriodEndDate?.ToDateTime(TimeOnly.MinValue);
        _guaranteeReleaseDate = _guaranteeForm.ReleaseDate?.ToDateTime(TimeOnly.MinValue);
    }

    private async Task SaveGuaranteeAsync()
    {
        try
        {
            _guaranteeForm!.IssueDate = _guaranteeIssueDate is { } i ? DateOnly.FromDateTime(i) : DateOnly.FromDateTime(DateTime.UtcNow);
            _guaranteeForm.ExpiryDate = _guaranteeExpiryDate is { } e ? DateOnly.FromDateTime(e) : DateOnly.FromDateTime(DateTime.UtcNow);
            _guaranteeForm.ClaimPeriodEndDate = _guaranteeClaimPeriodEndDate is { } c ? DateOnly.FromDateTime(c) : null;
            _guaranteeForm.ReleaseDate = _guaranteeReleaseDate is { } r ? DateOnly.FromDateTime(r) : null;

            using var scope = ScopeFactory.CreateScope();
            var service = scope.ServiceProvider.GetRequiredService<ITenderService>();

            if (_editingGuaranteeId is null)
                await service.AddGuaranteeAsync(Id, _guaranteeForm);
            else
                await service.UpdateGuaranteeAsync(_guaranteeForm);

            _guaranteeForm = null;
            Snackbar.Add("Security saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteGuaranteeAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ITenderService>().DeleteGuaranteeAsync(_deleteGuarantee!.Id);
            _deleteGuarantee = null;
            Snackbar.Add("Security deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _deleteGuarantee = null;
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // --- documents ---

    private void OpenDocumentEditor(TenderDocument? d)
    {
        _editingDocumentId = d?.Id;
        _documentForm = d is null
            ? new TenderDocument()
            : new TenderDocument
            {
                Id = d.Id, TenderRecordId = d.TenderRecordId, Category = d.Category, Name = d.Name,
                ReferenceNumber = d.ReferenceNumber, DocumentDate = d.DocumentDate, Notes = d.Notes
            };

        _documentDate = _documentForm.DocumentDate?.ToDateTime(TimeOnly.MinValue);
    }

    private async Task SaveDocumentAsync()
    {
        try
        {
            _documentForm!.DocumentDate = _documentDate is { } d ? DateOnly.FromDateTime(d) : null;

            using var scope = ScopeFactory.CreateScope();
            var service = scope.ServiceProvider.GetRequiredService<ITenderService>();

            if (_editingDocumentId is null)
                await service.AddDocumentAsync(Id, _documentForm);
            else
                await service.UpdateDocumentAsync(_documentForm);

            _documentForm = null;
            Snackbar.Add("Document saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteDocumentAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ITenderService>().DeleteDocumentAsync(_deleteDocument!.Id);
            _deleteDocument = null;
            Snackbar.Add("Document deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _deleteDocument = null;
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // --- competitors ---

    private void OpenCompetitorEditor(TenderCompetitor? c)
    {
        _editingCompetitorId = c?.Id;
        _competitorForm = c is null
            ? new TenderCompetitor()
            : new TenderCompetitor
            {
                Id = c.Id, TenderRecordId = c.TenderRecordId, BidderName = c.BidderName,
                QuotedAmount = c.QuotedAmount, Rank = c.Rank, IsOwnBid = c.IsOwnBid, Remarks = c.Remarks
            };
    }

    private async Task SaveCompetitorAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var service = scope.ServiceProvider.GetRequiredService<ITenderService>();

            if (_editingCompetitorId is null)
                await service.AddCompetitorAsync(Id, _competitorForm!);
            else
                await service.UpdateCompetitorAsync(_competitorForm!);

            _competitorForm = null;
            Snackbar.Add("Bidder saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteCompetitorAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ITenderService>().DeleteCompetitorAsync(_deleteCompetitor!.Id);
            _deleteCompetitor = null;
            Snackbar.Add("Bidder deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _deleteCompetitor = null;
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // --- tender ---

    private async Task DeleteTenderAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ITenderService>().DeleteAsync(Id);
            Snackbar.Add("Tender deleted.", Severity.Success);
            Nav.NavigateTo("/tender/tenders");
        }
        catch (Exception ex)
        {
            _confirmDeleteTender = false;
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
