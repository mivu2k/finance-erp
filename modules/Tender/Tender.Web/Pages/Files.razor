@page "/tender/files"
@attribute [Authorize(Policy = TenderPermissions.FilesView)]
@layout TenderLayout
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Nav

<PageTitle>File Registry</PageTitle>

<div class="d-flex align-center mb-4 flex-wrap gap-2">
    <MudText Typo="Typo.h5">File Registry</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Label"
               Href="@StickerSheetUrl" Target="_blank">Print Stickers</MudButton>
</div>

@if (_overdue > 0)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
        @_overdue file(s) are out past the date they were due back.
        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ShowOverdueAsync">Show them</MudButton>
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="_search" Label="Search file number, reference, title, holder or location"
                          Margin="Margin.Dense" Immediate="true" DebounceInterval="300"
                          OnDebounceIntervalElapsed="LoadAsync"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="FileStatus?" Value="_status" ValueChanged="OnStatusChanged" Label="Status"
                       Margin="Margin.Dense" Clearable="true">
                @foreach (var s in Enum.GetValues<FileStatus>())
                {
                    <MudSelectItem T="FileStatus?" Value="@((FileStatus?)s)">@s</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudSelect T="FileOwnerType?" Value="_ownerType" ValueChanged="OnOwnerTypeChanged" Label="Kind"
                       Margin="Margin.Dense" Clearable="true">
                @foreach (var t in Enum.GetValues<FileOwnerType>())
                {
                    <MudSelectItem T="FileOwnerType?" Value="@((FileOwnerType?)t)">@t</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="1" Class="d-flex align-center">
            <MudCheckBox T="bool" Value="_overdueOnly" ValueChanged="OnOverdueChanged" Label="Late" Dense="true" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-2" Style="overflow-x:auto">
    <MudSimpleTable Dense="true" Hover="true" Striped="true">
        <thead>
            <tr>
                <th>File No.</th><th>Kind</th><th>Reference</th><th>Title</th>
                <th>Held By</th><th>Location</th><th>Days Out</th><th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in _files)
            {
                <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/tender/files/{f.Id}"))">
                    <td style="white-space:nowrap"><b>@f.FileNumber</b></td>
                    <td>@f.OwnerType</td>
                    <td>@f.OwnerReference</td>
                    <td>@f.OwnerTitle</td>
                    <td>@f.HolderName</td>
                    <td>@f.Location</td>
                    <td>@(f.DaysOut?.ToString() ?? "")</td>
                    <td>
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(f.Status)">@f.Status</MudChip>
                    </td>
                </tr>
            }
            @if (_files.Count == 0)
            {
                <tr><td colspan="8" class="mud-text-secondary pa-4">No files match this filter.</td></tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@code {
    private List<PhysicalFile> _files = [];
    private string? _search;
    private FileStatus? _status;
    private FileOwnerType? _ownerType;
    private bool _overdueOnly;
    private int _overdue;

    private string StickerSheetUrl =>
        "/tender/print/file-stickers"
        + (_status is { } s ? $"?status={s}" : "")
        + (_ownerType is { } o ? (_status is null ? "?" : "&") + $"ownerType={o}" : "");

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnStatusChanged(FileStatus? status) { _status = status; await LoadAsync(); }
    private async Task OnOwnerTypeChanged(FileOwnerType? type) { _ownerType = type; await LoadAsync(); }
    private async Task OnOverdueChanged(bool value) { _overdueOnly = value; await LoadAsync(); }

    private async Task ShowOverdueAsync()
    {
        _overdueOnly = true;
        _status = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var service = scope.ServiceProvider.GetRequiredService<IFileRegistryService>();
        _files = await service.ListAsync(new FileFilter(_search, _status, _ownerType, _overdueOnly));
        _overdue = (await service.ListOverdueAsync()).Count;
        StateHasChanged();
    }

    internal static Color StatusColor(FileStatus status) => status switch
    {
        FileStatus.InRegistry => Color.Success,
        FileStatus.Issued => Color.Info,
        FileStatus.Archived => Color.Default,
        FileStatus.Lost => Color.Error,
        _ => Color.Default
    };
}
