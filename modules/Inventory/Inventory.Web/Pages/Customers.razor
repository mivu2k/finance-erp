@page "/inventory/customers"
@attribute [Authorize(Policy = InventoryPermissions.SalesManage)]
@layout InventoryLayout
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject ISnackbar Snackbar

<PageTitle>Customers</PageTitle>

<div class="d-flex align-center mb-4 flex-wrap gap-2">
    <MudText Typo="Typo.h5">Customers</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Open(null))">
        New Customer
    </MudButton>
</div>

<MudPaper Class="pa-4 mb-4">
    <MudTextField @bind-Value="_search" Label="Search name, code or phone" Margin="Margin.Dense"
                  Immediate="true" DebounceInterval="300" OnDebounceIntervalElapsed="LoadAsync"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
</MudPaper>

<MudPaper Class="pa-2" Style="overflow-x:auto">
    <MudSimpleTable Dense="true" Hover="true" Striped="true">
        <thead>
            <tr>
                <th>Name</th><th>Code</th><th>Contact</th><th>Phone</th>
                <th>Terms</th><th>Status</th><th style="width:96px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in _customers)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.Code</td>
                    <td>@c.ContactPerson</td>
                    <td>@c.Phone</td>
                    <td>@(c.PaymentTermDays is { } d ? $"{d} days" : "—")</td>
                    <td>
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(c.IsActive ? Color.Success : Color.Default)">
                            @(c.IsActive ? "Active" : "Inactive")
                        </MudChip>
                    </td>
                    <td>
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                       OnClick="@(() => Open(c))" />
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error" OnClick="@(() => _delete = c)" />
                    </td>
                </tr>
            }
            @if (_customers.Count == 0)
            {
                <tr><td colspan="7" class="mud-text-secondary pa-4">No customers match.</td></tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@if (_edit is not null)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Class="pa-6" Style="width:560px;max-width:95vw;max-height:92vh;overflow-y:auto">
            <MudText Typo="Typo.h6" Class="mb-3">@(_edit.Id == 0 ? "New Customer" : _edit.Name)</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="8"><MudTextField @bind-Value="_edit.Name" Label="Name" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_edit.Code" Label="Code" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_edit.ContactPerson" Label="Contact person" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_edit.Phone" Label="Phone" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_edit.Email" Label="Email" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="6"><MudTextField @bind-Value="_edit.TaxNumber" Label="NTN / Tax number" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_edit.Address" Label="Address" Lines="2" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField T="int?" @bind-Value="_edit.PaymentTermDays" Label="Payment terms (days)"
                                     Min="0" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6" Class="d-flex align-center">
                    <MudSwitch T="bool" @bind-Value="_edit.IsActive" Label="Active" Color="Color.Primary" />
                </MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_edit.Notes" Label="Notes" Lines="2" Margin="Margin.Dense" /></MudItem>
            </MudGrid>
            <div class="d-flex justify-end gap-2 mt-4">
                <MudButton OnClick="@(() => _edit = null)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@if (_delete is not null)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Class="pa-6" Style="width:460px;max-width:95vw">
            <MudText Typo="Typo.h6" Class="mb-2">Delete @_delete.Name?</MudText>
            <MudText Typo="Typo.body2" Class="mb-4">
                Only possible while they have no sales history — otherwise mark them inactive,
                so past orders still name who they went to.
            </MudText>
            <div class="d-flex justify-end gap-2">
                <MudButton OnClick="@(() => _delete = null)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Delete">Delete</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@code {
    private List<Customer> _customers = [];
    private Customer? _edit, _delete;
    private string? _search;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        _customers = await scope.ServiceProvider.GetRequiredService<ICustomerService>().ListAsync(_search);
        StateHasChanged();
    }

    private void Open(Customer? c) => _edit = c is null
        ? new Customer()
        : new Customer
        {
            Id = c.Id, Name = c.Name, Code = c.Code, ContactPerson = c.ContactPerson,
            Phone = c.Phone, Email = c.Email, Address = c.Address, TaxNumber = c.TaxNumber,
            PaymentTermDays = c.PaymentTermDays, Notes = c.Notes, IsActive = c.IsActive
        };

    private async Task Save()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ICustomerService>().SaveAsync(_edit!);
            _edit = null;
            Snackbar.Add("Customer saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Delete()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ICustomerService>().DeleteAsync(_delete!.Id);
            _delete = null;
            Snackbar.Add("Customer deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _delete = null;
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
