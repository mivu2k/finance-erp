@page "/inventory/products/new"
@attribute [Authorize(Policy = InventoryPermissions.ProductsManage)]
@layout InventoryLayout
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>New Product</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">New Product</MudText>

<MudPaper Class="pa-4" MaxWidth="600px">
    <MudTextField @bind-Value="_product.Name" Label="Name" Required="true" Margin="Margin.Dense" Class="mb-2" />
    <MudTextField @bind-Value="_product.Category" Label="Category" Margin="Margin.Dense" Class="mb-2" />
    <MudTextField @bind-Value="_product.SkuPrefix" Label="SKU prefix" Margin="Margin.Dense" Class="mb-2" />
    <MudTextField @bind-Value="_product.Description" Label="Description" Lines="3" Margin="Margin.Dense" Class="mb-2" />

    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Class="mt-2">Save</MudButton>
</MudPaper>

@code {
    private readonly Product _product = new();

    private async Task Save()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var saved = await scope.ServiceProvider.GetRequiredService<IProductService>().CreateAsync(_product);
            Snackbar.Add("Product created.", Severity.Success);
            Nav.NavigateTo($"/inventory/products/{saved.Id}");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
