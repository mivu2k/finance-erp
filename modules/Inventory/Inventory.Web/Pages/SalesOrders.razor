@page "/inventory/sales-orders"
@page "/inventory/sales-orders/{Id:int}"
@attribute [Authorize(Policy = InventoryPermissions.SalesManage)]
@layout InventoryLayout
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Sales Orders</PageTitle>

@if (_order is null)
{
    <div class="d-flex align-center mb-4 flex-wrap gap-2">
        <MudText Typo="Typo.h5">Sales Orders</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _draftOpen = true)">
            New Order
        </MudButton>
    </div>

    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
        An order is a commitment, not a movement — nothing leaves stock until a delivery
        note issues it, and confirming reserves nothing.
    </MudAlert>

    <MudPaper Class="pa-2" Style="overflow-x:auto">
        <MudSimpleTable Dense="true" Hover="true" Striped="true">
            <thead>
                <tr><th>Number</th><th>Date</th><th>Customer</th><th>Required</th>
                    <th>Lines</th><th style="text-align:right">Total</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var o in _orders)
                {
                    <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/inventory/sales-orders/{o.Id}"))">
                        <td>@o.OrderNumber</td>
                        <td>@o.Date.ToString("yyyy-MM-dd")</td>
                        <td>@o.Customer?.Name</td>
                        <td>@(o.RequiredBy?.ToString("yyyy-MM-dd") ?? "—")</td>
                        <td>@o.Lines.Count</td>
                        <td style="text-align:right">@o.TotalAmount.ToString("N2")</td>
                        <td><MudChip T="string" Size="Size.Small" Color="@StatusColour(o.Status)">@o.Status</MudChip></td>
                    </tr>
                }
                @if (_orders.Count == 0)
                {
                    <tr><td colspan="7" class="mud-text-secondary pa-4">No orders yet.</td></tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}
else
{
    <div class="d-flex align-center mb-4 flex-wrap gap-2">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/inventory/sales-orders" />
        <MudText Typo="Typo.h5">@_order.OrderNumber</MudText>
        <MudChip T="string" Size="Size.Small" Color="@StatusColour(_order.Status)">@_order.Status</MudChip>
        <MudSpacer />
        @if (_order.Status == SalesOrderStatus.Draft)
        {
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="Confirm">Confirm order</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                       OnClick="Cancel">Cancel</MudButton>
        }
        else if (_order.Status is SalesOrderStatus.Confirmed or SalesOrderStatus.PartlyDelivered)
        {
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.LocalShipping" OnClick="DeliverGoods">
                Deliver goods
            </MudButton>
        }
    </div>

    <MudGrid Spacing="3" Class="mb-2">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-3">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Customer</MudText>
                <MudText>@_order.Customer?.Name</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-3">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Required by</MudText>
                <MudText>@(_order.RequiredBy?.ToString("yyyy-MM-dd") ?? "—")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-3">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Total</MudText>
                <MudText Typo="Typo.h6">@_order.TotalAmount.ToString("N2")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-2" Style="overflow-x:auto">
        <MudSimpleTable Dense="true" Hover="true" Striped="true">
            <thead>
                <tr><th>Item</th><th style="text-align:right">Ordered</th>
                    <th style="text-align:right">Delivered</th><th style="text-align:right">Outstanding</th>
                    <th style="text-align:right">Unit price</th><th style="text-align:right">Amount</th></tr>
            </thead>
            <tbody>
                @foreach (var l in _order.Lines)
                {
                    <tr>
                        <td>@l.ItemName</td>
                        <td style="text-align:right">@l.Quantity.ToString("0.##")</td>
                        <td style="text-align:right">@l.DeliveredQuantity.ToString("0.##")</td>
                        <td style="text-align:right">
                            @if (l.Outstanding > 0)
                            {
                                <b>@l.Outstanding.ToString("0.##")</b>
                            }
                            else
                            {
                                <span class="mud-text-secondary">—</span>
                            }
                        </td>
                        <td style="text-align:right">@l.UnitPrice.ToString("N2")</td>
                        <td style="text-align:right">@l.LineTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@if (_draftOpen)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Class="pa-6" Style="width:680px;max-width:95vw;max-height:92vh;overflow-y:auto">
            <MudText Typo="Typo.h6" Class="mb-3">New Sales Order</MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudSelect T="int" @bind-Value="_customerId" Label="Customer" Margin="Margin.Dense">
                        @foreach (var c in _customers)
                        {
                            <MudSelectItem T="int" Value="@c.Id">@c.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="int?" @bind-Value="_warehouseId" Label="Ship from" Margin="Margin.Dense">
                        @foreach (var w in _warehouses)
                        {
                            <MudSelectItem T="int?" Value="@w.Id">@w.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudDatePicker Date="_required" DateChanged="@(d => _required = d)"
                                   Label="Required by" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_customerReference" Label="Customer's order number"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="5">
                    <MudSelect T="string" Value="_pickedItem" ValueChanged="OnItemPicked"
                               Label="Item" Margin="Margin.Dense">
                        @foreach (var i in _items)
                        {
                            <MudSelectItem T="string" Value="@i.Key">@i.Name (@i.Available.ToString("0.##") in stock)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="4" md="2">
                    <MudNumericField T="decimal" @bind-Value="_pickedQty" Label="Qty" Min="0.01M" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="4" md="3">
                    <MudNumericField T="decimal" @bind-Value="_pickedPrice" Label="Unit price" Min="0" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="4" md="2" Class="d-flex align-center">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="AddLine">Add</MudButton>
                </MudItem>
            </MudGrid>

            <MudSimpleTable Dense="true" Class="mt-3">
                <tbody>
                    @foreach (var l in _draftLines)
                    {
                        var line = l;
                        <tr>
                            <td>@line.ItemName</td>
                            <td style="text-align:right">@line.Quantity.ToString("0.##")</td>
                            <td style="text-align:right">@line.UnitPrice.ToString("N2")</td>
                            <td style="text-align:right">@((line.Quantity * line.UnitPrice).ToString("N2"))</td>
                            <td style="width:44px">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error" OnClick="@(() => _draftLines.Remove(line))" />
                            </td>
                        </tr>
                    }
                    @if (_draftLines.Count == 0)
                    {
                        <tr><td class="mud-text-secondary">No lines yet.</td></tr>
                    }
                </tbody>
            </MudSimpleTable>

            <div class="d-flex justify-end gap-2 mt-4">
                <MudButton OnClick="@(() => _draftOpen = false)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateDraft"
                           Disabled="@(_draftLines.Count == 0)">Create</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@code {
    [Parameter] public int? Id { get; set; }

    private List<SalesOrder> _orders = [];
    private SalesOrder? _order;

    private bool _draftOpen;
    private List<Customer> _customers = [];
    private List<Warehouse> _warehouses = [];
    private List<ItemOption> _items = [];
    private readonly List<SalesOrderLine> _draftLines = [];
    private int _customerId;
    private int? _warehouseId;
    private DateTime? _required = DateTime.Today.AddDays(7);
    private string? _customerReference;
    private string? _pickedItem;
    private decimal _pickedQty = 1, _pickedPrice;

    /// <summary>The sale price and stock figure ride along so the picker can prefill and warn.</summary>
    private record ItemOption(string Key, string Name, decimal SalePrice, decimal Available);

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private static Color StatusColour(SalesOrderStatus s) => s switch
    {
        SalesOrderStatus.Draft => Color.Info,
        SalesOrderStatus.Confirmed => Color.Primary,
        SalesOrderStatus.PartlyDelivered => Color.Warning,
        SalesOrderStatus.Delivered => Color.Success,
        _ => Color.Default
    };

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var svc = scope.ServiceProvider.GetRequiredService<ISalesOrderService>();

        if (Id is { } id)
        {
            _order = await svc.GetAsync(id);
        }
        else
        {
            _order = null;
            _orders = await svc.ListAsync();
            _customers = await scope.ServiceProvider.GetRequiredService<ICustomerService>()
                .ListAsync(activeOnly: true);
            _warehouses = await scope.ServiceProvider.GetRequiredService<IWarehouseService>()
                .ListAsync(activeOnly: true);
            _customerId = _customers.FirstOrDefault()?.Id ?? 0;
            _warehouseId = _warehouses.FirstOrDefault(w => w.IsDefault)?.Id
                           ?? _warehouses.FirstOrDefault()?.Id;

            var products = await scope.ServiceProvider.GetRequiredService<IProductService>().ListAsync();
            _items = products.SelectMany(p => p.Models.Select(m => new ItemOption(
                    $"{StockItemType.Model}:{m.Id}", $"{p.Name} › {m.Name}", m.SalePrice, m.CurrentQuantity)))
                .Concat(products.SelectMany(p => p.Models.SelectMany(m => m.Accessories.Select(a =>
                    new ItemOption($"{StockItemType.Accessory}:{a.Id}", $"{m.Name} › {a.Name}",
                        a.SalePrice, a.CurrentQuantity)))))
                .ToList();
        }
        StateHasChanged();
    }

    /// <summary>Prefills the price from the item's own sale price; it stays editable.</summary>
    private void OnItemPicked(string? key)
    {
        _pickedItem = key;
        if (_items.FirstOrDefault(i => i.Key == key) is { } item) _pickedPrice = item.SalePrice;
    }

    private void AddLine()
    {
        if (_pickedItem is null || _pickedQty <= 0) return;

        var item = _items.First(i => i.Key == _pickedItem);
        var parts = _pickedItem.Split(':');
        _draftLines.Add(new SalesOrderLine
        {
            ItemType = Enum.Parse<StockItemType>(parts[0]),
            ItemId = int.Parse(parts[1]),
            ItemName = item.Name,
            Quantity = _pickedQty, UnitPrice = _pickedPrice
        });

        // An order can be taken for more than is on the shelf — that is what a backorder
        // is — but the person taking it should know.
        if (_pickedQty > item.Available)
            Snackbar.Add($"Only {item.Available:0.##} of {item.Name} in stock. Order taken anyway.",
                Severity.Warning);

        _pickedQty = 1;
        _pickedPrice = 0;
    }

    private async Task<(string Id, string Name)> CurrentUserAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        return (user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "",
                user.FindFirst("full_name")?.Value ?? user.Identity?.Name ?? "Unknown");
    }

    private async Task CreateDraft()
    {
        try
        {
            var (userId, name) = await CurrentUserAsync();
            using var scope = ScopeFactory.CreateScope();
            var created = await scope.ServiceProvider.GetRequiredService<ISalesOrderService>()
                .SaveAsync(new SalesOrder
                {
                    CustomerId = _customerId,
                    WarehouseId = _warehouseId,
                    Date = DateOnly.FromDateTime(DateTime.Today),
                    RequiredBy = _required is { } r ? DateOnly.FromDateTime(r) : null,
                    CustomerReference = _customerReference,
                    RaisedById = userId,
                    RaisedByName = name,
                    Lines = _draftLines.ToList()
                });

            _draftOpen = false;
            _draftLines.Clear();
            Nav.NavigateTo($"/inventory/sales-orders/{created.Id}");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Confirm()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ISalesOrderService>().ConfirmAsync(_order!.Id);
            Snackbar.Add("Order confirmed.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Cancel()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ISalesOrderService>().CancelAsync(_order!.Id);
            Snackbar.Add("Order cancelled.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    /// <summary>Builds a draft delivery from what this order still owes.</summary>
    private async Task DeliverGoods()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var deliveries = scope.ServiceProvider.GetRequiredService<IDeliveryService>();

            var draft = await deliveries.BuildFromOrderAsync(_order!.Id);
            var saved = await deliveries.SaveAsync(draft);

            Snackbar.Add($"{saved.DeliveryNumber} drafted — check quantities and serials, then post.",
                Severity.Success);
            Nav.NavigateTo($"/inventory/deliveries/{saved.Id}");
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
