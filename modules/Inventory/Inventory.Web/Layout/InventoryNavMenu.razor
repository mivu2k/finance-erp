<MudNavMenu>
    <MudNavLink Href="/inventory" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">
        Dashboard
    </MudNavLink>

    <AuthorizeView Policy="@InventoryPermissions.ProductsView">
        <MudNavGroup Title="Products" Icon="@Icons.Material.Filled.Inventory2" Expanded="true">
            <MudNavLink Href="/inventory/products" Icon="@Icons.Material.Filled.List">All Products</MudNavLink>
            <AuthorizeView Policy="@InventoryPermissions.ProductsManage" Context="c">
                <MudNavLink Href="/inventory/products/new" Icon="@Icons.Material.Filled.AddBox">New Product</MudNavLink>
            </AuthorizeView>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Policy="@InventoryPermissions.ProductsView" Context="t">
        <MudNavLink Href="/inventory/transactions" Icon="@Icons.Material.Filled.History">
            Stock Ledger
        </MudNavLink>
    </AuthorizeView>

    <AuthorizeView Policy="@InventoryPermissions.WarehouseManage" Context="w">
        <MudNavGroup Title="Warehouses" Icon="@Icons.Material.Filled.Warehouse" Expanded="false">
            <MudNavLink Href="/inventory/warehouses" Icon="@Icons.Material.Filled.Store">Warehouses</MudNavLink>
            <MudNavLink Href="/inventory/transfers" Icon="@Icons.Material.Filled.SwapHoriz">Transfers</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Policy="@InventoryPermissions.PurchaseManage" Context="p">
        <MudNavGroup Title="Purchasing" Icon="@Icons.Material.Filled.ShoppingCart" Expanded="false">
            <MudNavLink Href="/inventory/suppliers" Icon="@Icons.Material.Filled.Storefront">Suppliers</MudNavLink>
            <MudNavLink Href="/inventory/purchase-orders" Icon="@Icons.Material.Filled.Receipt">Purchase Orders</MudNavLink>
            <MudNavLink Href="/inventory/receipts" Icon="@Icons.Material.Filled.MoveToInbox">Goods Received</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Policy="@InventoryPermissions.SalesManage" Context="s">
        <MudNavGroup Title="Sales" Icon="@Icons.Material.Filled.PointOfSale" Expanded="false">
            <MudNavLink Href="/inventory/customers" Icon="@Icons.Material.Filled.People">Customers</MudNavLink>
            <MudNavLink Href="/inventory/sales-orders" Icon="@Icons.Material.Filled.Receipt">Sales Orders</MudNavLink>
            <MudNavLink Href="/inventory/deliveries" Icon="@Icons.Material.Filled.LocalShipping">Deliveries</MudNavLink>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Policy="@InventoryPermissions.CountManage" Context="c">
        <MudNavLink Href="/inventory/counts" Icon="@Icons.Material.Filled.Checklist">Stock Takes</MudNavLink>
    </AuthorizeView>

    <AuthorizeView Policy="@InventoryPermissions.ReportsView" Context="r">
        <MudNavLink Href="/inventory/reports" Icon="@Icons.Material.Filled.Assessment">
            Reports
        </MudNavLink>
    </AuthorizeView>
</MudNavMenu>
