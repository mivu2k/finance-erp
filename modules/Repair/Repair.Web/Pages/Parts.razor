@page "/repair/parts"
@attribute [Authorize(Policy = RepairPermissions.PartsView)]
@layout RepairLayout
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject ISnackbar Snackbar

<PageTitle>Parts</PageTitle>

<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h5">Parts</MudText>
    <MudSpacer />
    <AuthorizeView Policy="@RepairPermissions.PartsManage">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Open(null))">New Part</MudButton>
    </AuthorizeView>
</div>

<MudPaper Class="pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="9">
            <MudTextField @bind-Value="_search" Label="Search name, SKU, brand or model"
                          Margin="Margin.Dense" Immediate="true" DebounceInterval="300"
                          OnDebounceIntervalElapsed="LoadAsync"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudSwitch T="bool" Value="_lowOnly" ValueChanged="OnLowChanged"
                       Label="Never purchased" Color="Color.Warning" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-2" Style="overflow-x:auto">
    <MudSimpleTable Dense="true" Hover="true" Striped="true">
        <thead>
            <tr><th>SKU</th><th>Name</th><th>Brand</th><th>Model</th>
                    <th style="text-align:right">Last cost</th><th style="text-align:right">Avg cost</th>
                <th style="text-align:right">Sell price</th><th style="text-align:right">Margin</th>
                <th>Last bought</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var p in _parts)
            {
                <tr>
                    <td>@p.Sku</td>
                    <td>@p.Name</td>
                    <td>@p.Brand</td>
                    <td>@p.Model</td>
                    <td style="text-align:right">
                        @(p.LastPurchaseCost?.ToString("N2") ?? "—")
                    </td>
                    <td style="text-align:right">@(p.AverageCost?.ToString("N2") ?? "—")</td>
                    <td style="text-align:right">@p.Price.ToString("N2")</td>
                    <td style="text-align:right">
                        @if (p.MarginPercent is { } margin)
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(margin < 0 ? Color.Error
                                              : margin < 10 ? Color.Warning : Color.Success)">
                                @margin.ToString("0.#")%
                            </MudChip>
                        }
                    </td>
                    <td>@(p.LastPurchasedOn?.ToString("yyyy-MM-dd") ?? "never")</td>
                    <td style="white-space:nowrap">
                        <AuthorizeView Policy="@RepairPermissions.PartsManage" Context="pm">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                           OnClick="@(() => Open(p))" />
                        </AuthorizeView>
                        <AuthorizeView Policy="@RepairPermissions.PurchasesView" Context="ph">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Timeline"
                                           Title="Price history" OnClick="@(() => History(p))" />
                        </AuthorizeView>
                    </td>
                </tr>
            }
            @if (_parts.Count == 0)
            {
                <tr><td colspan="10" class="mud-text-secondary pa-4">No parts match this filter.</td></tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@if (_historyOpen)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Class="pa-6" Style="width:620px;max-width:95vw;max-height:90vh;overflow-y:auto">
            <MudText Typo="Typo.h6" Class="mb-1">Price history</MudText>
            <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">@_historyFor</MudText>
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr><th>Date</th><th>Purchase</th><th>Supplier</th>
                        <th style="text-align:right">Qty</th><th style="text-align:right">Unit cost</th>
                        <th style="text-align:right">Change</th></tr>
                </thead>
                <tbody>
                    @{ decimal? previous = null; }
                    @foreach (var h in _history)
                    {
                        var change = previous is { } prev && prev > 0
                            ? (h.UnitCost - prev) / prev * 100m
                            : (decimal?)null;
                        previous = h.UnitCost;
                        <tr>
                            <td>@h.PurchasedOn.ToString("yyyy-MM-dd")</td>
                            <td>@h.PurchaseNumber</td>
                            <td>@h.SupplierName</td>
                            <td style="text-align:right">@h.Quantity.ToString("0.##")</td>
                            <td style="text-align:right">@h.UnitCost.ToString("N2")</td>
                            <td style="text-align:right">
                                @if (change is { } c && Math.Abs(c) >= 0.01m)
                                {
                                    <span style="@(c > 0 ? "color:var(--mud-palette-error)"
                                                        : "color:var(--mud-palette-success)")">
                                        @(c > 0 ? "+" : "")@c.ToString("0.#")%
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                    @if (_history.Count == 0)
                    {
                        <tr><td colspan="6" class="mud-text-secondary">
                            Never purchased — its cost is unknown and any margin is a guess.
                        </td></tr>
                    }
                </tbody>
            </MudSimpleTable>
            <div class="d-flex justify-end mt-4">
                <MudButton OnClick="@(() => _historyOpen = false)">Close</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@if (_editorOpen)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Class="pa-6" Style="width:480px;max-width:95vw">
            <MudText Typo="Typo.h6" Class="mb-3">@(_edit.Id == 0 ? "New Part" : _edit.Name)</MudText>
            <MudTextField @bind-Value="_edit.Name" Label="Name *" Class="mb-2" />
            <MudTextField @bind-Value="_edit.Sku" Label="SKU" Class="mb-2" />
            <MudTextField @bind-Value="_edit.Brand" Label="Brand" Class="mb-2" />
            <MudTextField @bind-Value="_edit.Model" Label="Model" Class="mb-2" />
            <MudNumericField T="decimal" @bind-Value="_edit.Price" Label="Selling price" Min="0"
                             HelperText="Cost comes from purchases and can't be typed here." />
            <div class="d-flex justify-end gap-2 mt-4">
                <MudButton OnClick="@(() => _editorOpen = false)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@code {
    private List<Part> _parts = [];
    private string? _search;
    private bool _lowOnly;

    private bool _editorOpen;
    private Part _edit = new();

    private bool _historyOpen;
    private string _historyFor = "";
    private List<PriceHistoryPoint> _history = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task OnLowChanged(bool v) { _lowOnly = v; await LoadAsync(); }

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        _parts = await scope.ServiceProvider.GetRequiredService<ICatalogService>()
            .ListPartsAsync(_search, _lowOnly);
        StateHasChanged();
    }

    private void Open(Part? p)
    {
        _edit = p is null
            ? new Part()
            : new Part
            {
                Id = p.Id, Sku = p.Sku, Name = p.Name, Brand = p.Brand,
                Model = p.Model, Price = p.Price
            };
        _editorOpen = true;
    }

    private async Task Save()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ICatalogService>().SavePartAsync(_edit);
            _editorOpen = false;
            Snackbar.Add("Part saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task History(Part part)
    {
        using var scope = ScopeFactory.CreateScope();
        _historyFor = part.Name;
        _history = await scope.ServiceProvider.GetRequiredService<IPurchaseService>()
            .GetPriceHistoryAsync(part.Id);
        _historyOpen = true;
    }
}
