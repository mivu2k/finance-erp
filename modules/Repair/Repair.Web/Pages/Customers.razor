@page "/repair/customers"
@attribute [Authorize(Policy = RepairPermissions.CustomersView)]
@layout RepairLayout
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject ISnackbar Snackbar

<PageTitle>Customers</PageTitle>

<div class="d-flex align-center mb-4 flex-wrap gap-2">
    <MudText Typo="Typo.h5">Customers</MudText>
    <MudSpacer />
    <AuthorizeView Policy="@RepairPermissions.CustomersManage">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="@(() => Open(null))">New Customer</MudButton>
    </AuthorizeView>
</div>

<MudPaper Class="pa-4 mb-4">
    <MudTextField @bind-Value="_search" Label="Search name, phone, organisation or email"
                  Margin="Margin.Dense" Immediate="true" DebounceInterval="300"
                  OnDebounceIntervalElapsed="LoadAsync"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
</MudPaper>

<MudPaper Class="pa-2" Style="overflow-x:auto">
    <MudSimpleTable Dense="true" Hover="true" Striped="true">
        <thead>
            <tr><th>Name</th><th>Phone</th><th>Organisation</th><th>Email</th><th>Prefers</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var c in _customers)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@c.Phone</td>
                    <td>@c.Organization</td>
                    <td>@c.Email</td>
                    <td>@c.CommunicationPreference</td>
                    <td style="white-space:nowrap">
                        <AuthorizeView Policy="@RepairPermissions.CustomersManage" Context="e">
                            <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                           OnClick="@(() => Open(c))" />
                        </AuthorizeView>
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.History"
                                       OnClick="@(() => ShowHistory(c))" />
                    </td>
                </tr>
            }
            @if (_customers.Count == 0)
            {
                <tr><td colspan="6" class="mud-text-secondary pa-4">No customers match this search.</td></tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@if (_editorOpen)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Class="pa-6" Style="width:560px;max-width:95vw;max-height:90vh;overflow-y:auto">
            <MudText Typo="Typo.h6" Class="mb-3">@(_edit.Id == 0 ? "New Customer" : _edit.Name)</MudText>
            <MudTextField @bind-Value="_edit.Name" Label="Name *" Class="mb-2" />
            <MudTextField @bind-Value="_edit.Phone" Label="Phone *" Class="mb-2" />
            <MudTextField @bind-Value="_edit.Email" Label="Email" Class="mb-2" />
            <MudTextField @bind-Value="_edit.Organization" Label="Organisation" Class="mb-2" />
            <MudTextField @bind-Value="_edit.Address" Label="Address" Lines="2" Class="mb-2" />
            <MudSelect T="CommunicationPreference" @bind-Value="_edit.CommunicationPreference"
                       Label="Preferred contact" Class="mb-2">
                @foreach (var p in Enum.GetValues<CommunicationPreference>())
                {
                    <MudSelectItem Value="@p">@p</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_edit.Notes" Label="Notes" Lines="2" />
            <div class="d-flex justify-end gap-2 mt-4">
                <MudButton OnClick="@(() => _editorOpen = false)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@if (_historyOpen)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Class="pa-6" Style="width:720px;max-width:95vw;max-height:90vh;overflow-y:auto">
            <MudText Typo="Typo.h6" Class="mb-3">@_historyFor — repair history</MudText>
            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>Job</th><th>Device</th><th>Received</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var j in _history)
                    {
                        <tr>
                            <td><MudLink Href="@($"/repair/jobs/{j.Id}")">@j.JobNumber</MudLink></td>
                            <td>@j.DeviceName @j.Model</td>
                            <td>@j.CreatedAtUtc.ToString("yyyy-MM-dd")</td>
                            <td><JobStatusChip Status="@j.Status" /></td>
                        </tr>
                    }
                    @if (_history.Count == 0)
                    {
                        <tr><td colspan="4" class="mud-text-secondary">Nothing on file yet.</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
            <div class="d-flex justify-end mt-4">
                <MudButton OnClick="@(() => _historyOpen = false)">Close</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@code {
    private List<Customer> _customers = [];
    private string? _search;

    private bool _editorOpen;
    private Customer _edit = new();

    private bool _historyOpen;
    private string _historyFor = "";
    private List<RepairJob> _history = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        _customers = await scope.ServiceProvider.GetRequiredService<ICustomerService>()
            .ListAsync(_search);
        StateHasChanged();
    }

    private void Open(Customer? c)
    {
        // Edit a copy so cancelling doesn't leave edits on the grid.
        _edit = c is null
            ? new Customer()
            : new Customer
            {
                Id = c.Id, Name = c.Name, Phone = c.Phone, Email = c.Email,
                Organization = c.Organization, Address = c.Address,
                CommunicationPreference = c.CommunicationPreference, Notes = c.Notes
            };
        _editorOpen = true;
    }

    private async Task Save()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            await scope.ServiceProvider.GetRequiredService<ICustomerService>().SaveAsync(_edit);
            _editorOpen = false;
            Snackbar.Add("Customer saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ShowHistory(Customer c)
    {
        using var scope = ScopeFactory.CreateScope();
        _history = await scope.ServiceProvider.GetRequiredService<ICustomerService>()
            .HistoryAsync(c.Id);
        _historyFor = c.Name;
        _historyOpen = true;
    }
}
