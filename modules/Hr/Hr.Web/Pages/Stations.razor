@page "/hr/stations"
@attribute [Authorize(Policy = HrPermissions.DevicesManage)]
@layout HrLayout
@rendermode InteractiveServer
@using System.Security.Cryptography
@using Hr.Domain
@using Hr.Infrastructure
@using Microsoft.EntityFrameworkCore
@inject IServiceScopeFactory ScopeFactory
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Attendance Stations</PageTitle>

<div class="d-flex align-center mb-4 flex-wrap gap-2">
    <MudText Typo="Typo.h5">Attendance Stations</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Open(null))">Add Station</MudButton>
</div>

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
    A station is a PC by a door with an NFC reader and a QR scanner plugged in. Open
    its link there in full screen and leave it. Both readers act as keyboards, so
    there is nothing to install. <b>The link is the station's credential</b> — anyone
    who has it can record punches, so don't circulate it.
</MudAlert>

<MudPaper Class="pa-2" Style="overflow-x:auto">
    <MudSimpleTable Dense="true" Hover="true" Striped="true">
        <thead>
            <tr><th>Name</th><th>Location</th><th>Last punch</th><th>Enabled</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var s in _stations)
            {
                var station = s;
                <tr>
                    <td>@s.Name</td>
                    <td>@s.Location</td>
                    <td>
                        @(s.LastPunchAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "never")
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                            @s.LastPunchDescription
                        </MudText>
                    </td>
                    <td>
                        <MudIcon Size="Size.Small"
                                 Icon="@(s.IsEnabled ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                 Color="@(s.IsEnabled ? Color.Success : Color.Default)" />
                    </td>
                    <td style="white-space:nowrap">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.OpenInNew"
                                       Title="Open the kiosk" Href="@KioskUrl(station)" Target="_blank" />
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Autorenew"
                                       Title="Re-issue the link (the old one stops working)"
                                       OnClick="@(() => Reissue(station))" />
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                       OnClick="@(() => Open(station))" />
                    </td>
                </tr>
            }
            @if (_stations.Count == 0)
            {
                <tr><td colspan="5" class="mud-text-secondary pa-4">
                    No stations yet. Add one for each door you want people to clock in at.
                </td></tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@if (_editorOpen)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Class="pa-6" Style="width:520px;max-width:95vw">
            <MudText Typo="Typo.h6" Class="mb-3">@(_edit.Id == 0 ? "Add Station" : _edit.Name)</MudText>
            <MudTextField @bind-Value="_edit.Name" Label="Name *" Class="mb-2"
                          HelperText="e.g. Main Gate" />
            <MudTextField @bind-Value="_edit.Location" Label="Location" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_edit.IsEnabled" Color="Color.Primary" Label="Enabled"
                       Class="mb-2" />

            @if (_edit.Id != 0)
            {
                <MudTextField Value="@KioskUrl(_edit)" Label="Kiosk link" ReadOnly="true"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                              HelperText="Open this on the station PC and leave it in full screen." />
            }

            <div class="d-flex justify-end gap-2 mt-4">
                <MudButton OnClick="@(() => _editorOpen = false)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save"
                           Disabled="@string.IsNullOrWhiteSpace(_edit.Name)">Save</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@code {
    private List<AttendanceStation> _stations = [];
    private AttendanceStation _edit = new();
    private bool _editorOpen;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<HrDbContext>();
        _stations = await db.AttendanceStations.AsNoTracking().OrderBy(s => s.Name).ToListAsync();
    }

    private string KioskUrl(AttendanceStation s) =>
        Nav.ToAbsoluteUri($"/hr/kiosk/{s.AccessToken}").ToString();

    private void Open(AttendanceStation? s)
    {
        _edit = s is null
            ? new AttendanceStation { IsEnabled = true }
            : new AttendanceStation
            {
                Id = s.Id, Name = s.Name, Location = s.Location,
                IsEnabled = s.IsEnabled, AccessToken = s.AccessToken
            };
        _editorOpen = true;
    }

    private async Task Save()
    {
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<HrDbContext>();

        if (_edit.Id == 0)
        {
            _edit.AccessToken = NewToken();
            db.AttendanceStations.Add(_edit);
        }
        else
        {
            var row = await db.AttendanceStations.FirstAsync(s => s.Id == _edit.Id);
            row.Name = _edit.Name;
            row.Location = _edit.Location;
            row.IsEnabled = _edit.IsEnabled;
        }

        await db.SaveChangesAsync();
        _editorOpen = false;
        await LoadAsync();
        Snackbar.Add("Station saved.", Severity.Success);
    }

    /// <summary>
    /// Replaces the token, which is how you retire a link that has leaked or a PC
    /// that has gone missing. The old URL stops working immediately.
    /// </summary>
    private async Task Reissue(AttendanceStation station)
    {
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<HrDbContext>();
        var row = await db.AttendanceStations.FirstAsync(s => s.Id == station.Id);
        row.AccessToken = NewToken();
        await db.SaveChangesAsync();

        await LoadAsync();
        Snackbar.Add($"{row.Name} re-issued — reopen the kiosk on that PC.", Severity.Warning);
    }

    /// <summary>URL-safe and long enough that guessing one is not worth attempting.</summary>
    private static string NewToken() =>
        Convert.ToBase64String(RandomNumberGenerator.GetBytes(24))
            .Replace('+', '-').Replace('/', '_').TrimEnd('=');
}
