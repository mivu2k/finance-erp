@page "/hr/attendance/monthly"
@attribute [Authorize(Policy = HrPermissions.AttendanceViewAll)]
@layout HrLayout
@rendermode InteractiveServer
@using Hr.Infrastructure.Attendance
@inject IServiceScopeFactory ScopeFactory
@inject ISnackbar Snackbar

<PageTitle>Monthly Attendance</PageTitle>

<div class="d-flex align-center mb-4 flex-wrap gap-2">
    <MudText Typo="Typo.h5">Monthly Attendance</MudText>
    <MudSpacer />
    <AuthorizeView Policy="@HrPermissions.AttendanceEdit" Context="rb">
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@_busy"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="Rebuild">Recompute Month</MudButton>
    </AuthorizeView>
    <MudButton Variant="Variant.Outlined" Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Download"
               Href="@($"/hr/export/attendance/monthly/{_year}/{_month}")">Excel</MudButton>
</div>

<MudPaper Class="pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="6" md="3">
            <MudSelect T="int" Value="_month" ValueChanged="OnMonthChanged" Label="Month"
                       Margin="Margin.Dense">
                @for (var m = 1; m <= 12; m++)
                {
                    var month = m;
                    <MudSelectItem T="int" Value="@month">
                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudSelect T="int" Value="_year" ValueChanged="OnYearChanged" Label="Year"
                       Margin="Margin.Dense">
                @for (var y = DateTime.Today.Year - 3; y <= DateTime.Today.Year + 1; y++)
                {
                    var year = y;
                    <MudSelectItem T="int" Value="@year">@year</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="int?" Value="_departmentId" ValueChanged="OnDepartmentChanged"
                       Label="Department" Margin="Margin.Dense" Clearable="true">
                @foreach (var d in _departments)
                {
                    <MudSelectItem T="int?" Value="@d.Id">@d.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <div class="d-flex gap-2 mt-3 flex-wrap">
        @foreach (var s in new[] { AttendanceStatus.Present, AttendanceStatus.Late,
                                   AttendanceStatus.HalfDay, AttendanceStatus.Absent,
                                   AttendanceStatus.OnLeave, AttendanceStatus.Holiday,
                                   AttendanceStatus.WeeklyOff, AttendanceStatus.Incomplete })
        {
            <MudChip T="string" Size="Size.Small" Style="@Style(s)">@Mark(s) — @s</MudChip>
        }
    </div>
</MudPaper>

<MudPaper Class="pa-2" Style="overflow-x:auto">
    <table style="border-collapse:collapse;font-size:0.8rem;min-width:100%">
        <thead>
            <tr>
                <th style="text-align:left;padding:6px;position:sticky;left:0;background:var(--mud-palette-surface);z-index:1">
                    Employee
                </th>
                @for (var d = 1; d <= _daysInMonth; d++)
                {
                    var date = new DateOnly(_year, _month, d);
                    <th style="@($"padding:4px;text-align:center;min-width:26px;{(date.DayOfWeek is DayOfWeek.Sunday ? "background:var(--mud-palette-action-disabled-background)" : "")}")">
                        @d<br /><span style="font-size:0.65rem;opacity:.6">@date.ToString("ddd")[..1]</span>
                    </th>
                }
                <th style="padding:6px;text-align:right">P</th>
                <th style="padding:6px;text-align:right">L</th>
                <th style="padding:6px;text-align:right">A</th>
                <th style="padding:6px;text-align:right">LV</th>
                <th style="padding:6px;text-align:right;white-space:nowrap">Payable</th>
                <th style="padding:6px;text-align:right;white-space:nowrap">OT (h)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in _rows)
            {
                <tr>
                    <td style="padding:6px;position:sticky;left:0;background:var(--mud-palette-surface);white-space:nowrap">
                        @row.EmployeeName
                        <span style="opacity:.6">(@row.EmployeeCode)</span>
                    </td>
                    @for (var d = 1; d <= _daysInMonth; d++)
                    {
                        if (row.Days.TryGetValue(d, out var day))
                        {
                            <td style="@($"padding:4px;text-align:center;{Style(day.Status)}")"
                                title="@Tooltip(day)">
                                @Mark(day.Status)
                            </td>
                        }
                        else
                        {
                            <td style="padding:4px;text-align:center;opacity:.3">·</td>
                        }
                    }
                    <td style="padding:6px;text-align:right">@row.Present</td>
                    <td style="padding:6px;text-align:right">@row.Late</td>
                    <td style="padding:6px;text-align:right">@row.Absent</td>
                    <td style="padding:6px;text-align:right">@row.OnLeave</td>
                    <td style="padding:6px;text-align:right;font-weight:600">@row.PayableDays.ToString("0.#")</td>
                    <td style="padding:6px;text-align:right">@((row.OvertimeMinutes / 60.0).ToString("0.#"))</td>
                </tr>
            }
            @if (_rows.Count == 0)
            {
                <tr><td colspan="99" class="mud-text-secondary pa-4">No employees for this month.</td></tr>
            }
        </tbody>
    </table>
</MudPaper>

@code {
    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;
    private int? _departmentId;

    private List<MonthlySummary> _rows = [];
    private bool _busy;
    private List<Department> _departments = [];

    private int _daysInMonth => DateTime.DaysInMonth(_year, _month);

    protected override async Task OnInitializedAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        _departments = await scope.ServiceProvider.GetRequiredService<IEmployeeService>()
            .ListDepartmentsAsync();
        await LoadAsync();
    }

    private async Task OnMonthChanged(int m) { _month = m; await LoadAsync(); }
    private async Task OnYearChanged(int y) { _year = y; await LoadAsync(); }
    private async Task OnDepartmentChanged(int? id) { _departmentId = id; await LoadAsync(); }

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        _rows = await scope.ServiceProvider.GetRequiredService<IAttendanceService>()
            .GetMonthlyAsync(_year, _month, _departmentId);
        StateHasChanged();
    }

    /// <summary>
    /// Re-derives every day in the month from the stored punches. Needed after a
    /// shift or holiday changes, since those decide what counts as late or absent.
    /// Days corrected by hand are left alone.
    /// </summary>
    private async Task Rebuild()
    {
        _busy = true;
        try
        {
            var from = new DateOnly(_year, _month, 1);
            var to = from.AddMonths(1).AddDays(-1);

            using var scope = ScopeFactory.CreateScope();
            var count = await scope.ServiceProvider.GetRequiredService<IAttendanceSyncService>()
                .RebuildAsync(from, to);

            Snackbar.Add($"Recomputed {count} day(s).", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private static string Mark(AttendanceStatus s) => s switch
    {
        AttendanceStatus.Present => "P",
        AttendanceStatus.Late => "L",
        AttendanceStatus.HalfDay => "H",
        AttendanceStatus.Absent => "A",
        AttendanceStatus.OnLeave => "LV",
        AttendanceStatus.Holiday => "HO",
        AttendanceStatus.WeeklyOff => "W",
        AttendanceStatus.Incomplete => "?",
        _ => ""
    };

    private static string Style(AttendanceStatus s) => s switch
    {
        AttendanceStatus.Present => "background:#C8E6C9;color:#1b5e20",
        AttendanceStatus.Late => "background:#FFE0B2;color:#e65100",
        AttendanceStatus.HalfDay => "background:#FFF9C4;color:#f57f17",
        AttendanceStatus.Absent => "background:#FFCDD2;color:#b71c1c",
        AttendanceStatus.OnLeave => "background:#BBDEFB;color:#0d47a1",
        AttendanceStatus.Holiday => "background:#E1BEE7;color:#4a148c",
        AttendanceStatus.WeeklyOff => "background:#ECEFF1;color:#455a64",
        AttendanceStatus.Incomplete => "background:#FFCCBC;color:#bf360c",
        _ => ""
    };

    private static string Tooltip(AttendanceDay day) =>
        day.FirstIn is { } inAt
            ? $"{inAt:HH\\:mm}–{day.LastOut:HH\\:mm} · {day.WorkedMinutes / 60}h {day.WorkedMinutes % 60:00}m"
              + (day.Source == AttendanceSource.Manual ? $" · manual: {day.OverrideReason}" : "")
            : day.Status.ToString();
}
