@page "/hr/employees"
@attribute [Authorize(Policy = HrPermissions.EmployeesView)]
@layout HrLayout
@rendermode InteractiveServer
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Nav

<PageTitle>Employees</PageTitle>

<div class="d-flex align-center mb-4 flex-wrap gap-2">
    <MudText Typo="Typo.h5">Employees</MudText>
    <MudSpacer />
    <AuthorizeView Policy="@HrPermissions.EmployeesManage">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   Href="/hr/employees/new">New Employee</MudButton>
    </AuthorizeView>
</div>

<MudPaper Class="pa-4 mb-4">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_search" Label="Search name, code, phone or ID"
                          Margin="Margin.Dense" Immediate="true" DebounceInterval="300"
                          OnDebounceIntervalElapsed="LoadAsync"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>
        <MudItem xs="6" md="3">
            <MudSelect T="int?" Value="_departmentId" ValueChanged="OnDepartmentChanged"
                       Label="Department" Margin="Margin.Dense" Clearable="true">
                @foreach (var d in _departments)
                {
                    <MudSelectItem T="int?" Value="@d.Id">@d.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="3">
            <MudSelect T="EmployeeStatus?" Value="_status" ValueChanged="OnStatusChanged"
                       Label="Status" Margin="Margin.Dense" Clearable="true">
                @foreach (var s in Enum.GetValues<EmployeeStatus>())
                {
                    <MudSelectItem T="EmployeeStatus?" Value="@s">@s</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2" Class="d-flex align-center">
            <MudSwitch T="bool" Value="_includeLeavers" ValueChanged="OnIncludeLeaversChanged"
                       Label="Include leavers" Color="Color.Primary" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-2" Style="overflow-x:auto">
    <MudSimpleTable Dense="true" Hover="true" Striped="true">
        <thead>
            <tr>
                <th>Code</th><th>Name</th><th>Department</th><th>Designation</th>
                <th>Phone</th><th>Joined</th><th>Status</th><th>Login</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in _employees)
            {
                <tr style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/hr/employees/{e.Id}"))">
                    <td>@e.EmployeeCode</td>
                    <td>@e.FullName</td>
                    <td>@e.Department?.Name</td>
                    <td>@e.Designation?.Title</td>
                    <td>@e.Phone</td>
                    <td>@e.JoinedOn.ToString("yyyy-MM-dd")</td>
                    <td>
                        <MudChip T="string" Size="Size.Small" Color="@StatusColour(e.Status)">@e.Status</MudChip>
                    </td>
                    <td>
                        @if (e.UserId is not null)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                        }
                    </td>
                </tr>
            }
            @if (_employees.Count == 0)
            {
                <tr><td colspan="8" class="mud-text-secondary pa-4">No employees match this filter.</td></tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@code {
    private List<Employee> _employees = [];
    private List<Department> _departments = [];
    private string? _search;
    private int? _departmentId;
    private EmployeeStatus? _status;
    private bool _includeLeavers;

    protected override async Task OnInitializedAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        _departments = await scope.ServiceProvider.GetRequiredService<IEmployeeService>()
            .ListDepartmentsAsync();
        await LoadAsync();
    }

    private static Color StatusColour(EmployeeStatus s) => s switch
    {
        EmployeeStatus.Active => Color.Success,
        EmployeeStatus.OnLeave => Color.Info,
        EmployeeStatus.Suspended => Color.Warning,
        _ => Color.Default
    };

    private async Task OnDepartmentChanged(int? value) { _departmentId = value; await LoadAsync(); }
    private async Task OnStatusChanged(EmployeeStatus? value) { _status = value; await LoadAsync(); }
    private async Task OnIncludeLeaversChanged(bool value) { _includeLeavers = value; await LoadAsync(); }

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        _employees = await scope.ServiceProvider.GetRequiredService<IEmployeeService>()
            .ListAsync(new EmployeeFilter(_search, _departmentId, null, _status, _includeLeavers));
        StateHasChanged();
    }
}
