@page "/hr/devices"
@attribute [Authorize(Policy = HrPermissions.DevicesManage)]
@layout HrLayout
@rendermode InteractiveServer
@using Hr.Infrastructure.Attendance
@using Hr.Infrastructure.Devices
@inject IServiceScopeFactory ScopeFactory
@inject ISnackbar Snackbar

<PageTitle>Biometric Devices</PageTitle>

<div class="d-flex align-center mb-4 flex-wrap gap-2">
    <MudText Typo="Typo.h5">Biometric Devices</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sync"
               OnClick="SyncAll" Disabled="@_busy">Sync All Now</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Open(null))">Add Device</MudButton>
</div>

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
    Terminals are polled automatically in the background. They keep their logs on
    board, so a missed poll costs nothing — the next one picks up everything since.
</MudAlert>

<MudPaper Class="pa-2 mb-4" Style="overflow-x:auto">
    <MudSimpleTable Dense="true" Hover="true" Striped="true">
        <thead>
            <tr>
                <th>Name</th><th>Address</th><th>Location</th><th>Serial</th>
                <th>Last Sync</th><th>Result</th><th>Enabled</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in _devices)
            {
                <tr>
                    <td>@d.Name</td>
                    <td>@d.Host:@d.Port</td>
                    <td>@d.Location</td>
                    <td>@d.SerialNumber</td>
                    <td>@(d.LastSyncAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "never")</td>
                    <td style="max-width:340px">
                        <MudText Typo="Typo.caption">@d.LastSyncResult</MudText>
                    </td>
                    <td>
                        <MudIcon Size="Size.Small"
                                 Icon="@(d.IsEnabled ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                 Color="@(d.IsEnabled ? Color.Success : Color.Default)" />
                    </td>
                    <td style="white-space:nowrap">
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.NetworkCheck"
                                       Title="Test connection" Disabled="@_busy"
                                       OnClick="@(() => Test(d))" />
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Sync"
                                       Title="Sync now" Disabled="@_busy"
                                       OnClick="@(() => SyncOne(d))" />
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.People"
                                       Title="Enrolled users" Disabled="@_busy"
                                       OnClick="@(() => ReadUsers(d))" />
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Edit"
                                       OnClick="@(() => Open(d))" />
                    </td>
                </tr>
            }
            @if (_devices.Count == 0)
            {
                <tr><td colspan="8" class="mud-text-secondary pa-4">
                    No terminals yet. Add your uFace 800 with its IP address and port 4370.
                </td></tr>
            }
        </tbody>
    </MudSimpleTable>
</MudPaper>

@if (_unmatched.Count > 0)
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="mb-1">Unmatched device IDs</MudText>
        <MudText Typo="Typo.body2" Class="mb-3 mud-text-secondary">
            These IDs are punching at a terminal but match no employee. Point each at
            a person and their past punches are backfilled.
        </MudText>
        <MudSimpleTable Dense="true">
            <thead><tr><th>Device ID</th><th>Punches</th><th>Last seen</th><th>Assign to</th></tr></thead>
            <tbody>
                @foreach (var u in _unmatched)
                {
                    var deviceUserId = u.DeviceUserId;
                    <tr>
                        <td><b>@deviceUserId</b></td>
                        <td>@u.Count</td>
                        <td>@u.LastSeen.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            <MudSelect T="int?" Value="@_assign.GetValueOrDefault(deviceUserId)"
                                       ValueChanged="@(v => Assign(deviceUserId, v))"
                                       Margin="Margin.Dense" Style="min-width:240px"
                                       Placeholder="Pick an employee">
                                @foreach (var e in _employees)
                                {
                                    <MudSelectItem T="int?" Value="@e.Id">
                                        @e.FullName (@e.EmployeeCode)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@if (_editorOpen)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Class="pa-6" Style="width:520px;max-width:95vw;max-height:90vh;overflow-y:auto">
            <MudText Typo="Typo.h6" Class="mb-3">@(_edit.Id == 0 ? "Add Device" : _edit.Name)</MudText>
            <MudTextField @bind-Value="_edit.Name" Label="Name *" Class="mb-2"
                          HelperText="e.g. Main Gate uFace 800" />
            <MudTextField @bind-Value="_edit.Host" Label="IP address or hostname *" Class="mb-2" />
            <MudNumericField T="int" @bind-Value="_edit.Port" Label="Port" Min="1" Max="65535" Class="mb-2"
                             HelperText="4370 unless you changed it on the device." />
            <MudNumericField T="int" @bind-Value="_edit.CommKey" Label="Comm key" Min="0" Class="mb-2"
                             HelperText="0 unless a comm key is set in the device's Comm menu." />
            <MudTextField @bind-Value="_edit.Location" Label="Location" Class="mb-2" />
            <MudSwitch T="bool" @bind-Value="_edit.IsEnabled" Label="Poll this device" Color="Color.Primary" />
            <MudSwitch T="bool" @bind-Value="_edit.ClearLogAfterSync" Color="Color.Warning"
                       Label="Clear the device log after each successful sync" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Leave off unless the terminal is filling up. Keeping the on-board log
                is the only way to re-sync from an older database backup.
            </MudText>
            <div class="d-flex justify-end gap-2 mt-4">
                <MudButton OnClick="@(() => _editorOpen = false)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Save</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@if (_deviceUsers is not null)
{
    <MudOverlay Visible="true" DarkBackground="true" ZIndex="1300">
        <MudPaper Class="pa-6" Style="width:600px;max-width:95vw;max-height:90vh;overflow-y:auto">
            <MudText Typo="Typo.h6" Class="mb-3">Enrolled on the terminal</MudText>
            <MudSimpleTable Dense="true" Hover="true">
                <thead><tr><th>Device ID</th><th>Name</th><th>Matches an employee</th></tr></thead>
                <tbody>
                    @foreach (var u in _deviceUsers)
                    {
                        var known = _employees.Any(e =>
                            string.Equals(e.EffectiveDeviceUserId, u.DeviceUserId,
                                StringComparison.OrdinalIgnoreCase));
                        <tr>
                            <td>@u.DeviceUserId</td>
                            <td>@u.Name</td>
                            <td>
                                <MudIcon Size="Size.Small"
                                         Icon="@(known ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)"
                                         Color="@(known ? Color.Success : Color.Warning)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
            <div class="d-flex justify-end mt-4">
                <MudButton OnClick="@(() => _deviceUsers = null)">Close</MudButton>
            </div>
        </MudPaper>
    </MudOverlay>
}

@code {
    private List<BiometricDevice> _devices = [];
    private List<Employee> _employees = [];
    private List<(string DeviceUserId, int Count, DateTime LastSeen)> _unmatched = [];
    private readonly Dictionary<string, int?> _assign = [];

    private bool _busy;
    private bool _editorOpen;
    private BiometricDevice _edit = new();
    private IReadOnlyList<ZkUser>? _deviceUsers;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        using var scope = ScopeFactory.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<HrDbContext>();
        _devices = await db.BiometricDevices.OrderBy(d => d.Name).ToListAsync();
        _employees = await scope.ServiceProvider.GetRequiredService<IEmployeeService>()
            .ListAsync(new EmployeeFilter());
        _unmatched = await scope.ServiceProvider.GetRequiredService<IAttendanceService>()
            .GetUnmatchedAsync();
        StateHasChanged();
    }

    private void Open(BiometricDevice? d)
    {
        _edit = d is null
            ? new BiometricDevice { Port = 4370, IsEnabled = true }
            : new BiometricDevice
            {
                Id = d.Id, Name = d.Name, Host = d.Host, Port = d.Port, CommKey = d.CommKey,
                Location = d.Location, IsEnabled = d.IsEnabled,
                ClearLogAfterSync = d.ClearLogAfterSync
            };
        _editorOpen = true;
    }

    private async Task Save()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(_edit.Name) || string.IsNullOrWhiteSpace(_edit.Host))
                throw new InvalidOperationException("Name and address are required.");

            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<HrDbContext>();

            if (_edit.Id == 0)
            {
                db.BiometricDevices.Add(_edit);
            }
            else
            {
                var existing = await db.BiometricDevices.FirstAsync(d => d.Id == _edit.Id);
                existing.Name = _edit.Name;
                existing.Host = _edit.Host;
                existing.Port = _edit.Port;
                existing.CommKey = _edit.CommKey;
                existing.Location = _edit.Location;
                existing.IsEnabled = _edit.IsEnabled;
                existing.ClearLogAfterSync = _edit.ClearLogAfterSync;
            }

            await db.SaveChangesAsync();
            _editorOpen = false;
            Snackbar.Add("Device saved.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Test(BiometricDevice device)
    {
        _busy = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var info = await scope.ServiceProvider.GetRequiredService<IAttendanceSyncService>()
                .TestAsync(device.Id);

            Snackbar.Add(
                $"Connected. {info.DeviceName ?? "Device"} serial {info.SerialNumber ?? "?"}, " +
                $"firmware {info.FirmwareVersion ?? "?"}, {info.UserCount} user(s), " +
                $"{info.RecordCount} record(s). Device clock: " +
                $"{info.DeviceTime?.ToString("yyyy-MM-dd HH:mm") ?? "unreadable"}.",
                Severity.Success);

            // A drifting device clock is the single most common cause of odd
            // attendance figures, so it's worth calling out.
            if (info.DeviceTime is { } clock && Math.Abs((DateTime.Now - clock).TotalMinutes) > 5)
                Snackbar.Add(
                    $"The device clock is off by {(DateTime.Now - clock).TotalMinutes:0} minute(s). " +
                    "Correct it on the terminal or punch times will be wrong.",
                    Severity.Warning);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task SyncOne(BiometricDevice device)
    {
        _busy = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var result = await scope.ServiceProvider.GetRequiredService<IAttendanceSyncService>()
                .SyncDeviceAsync(device.Id);

            Snackbar.Add(result.Message, result.Succeeded ? Severity.Success : Severity.Error);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task SyncAll()
    {
        _busy = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var results = await scope.ServiceProvider.GetRequiredService<IAttendanceSyncService>()
                .SyncAllAsync();

            if (results.Count == 0) Snackbar.Add("No enabled devices to sync.", Severity.Info);
            foreach (var r in results)
                Snackbar.Add($"{r.DeviceName}: {r.Message}",
                    r.Succeeded ? Severity.Success : Severity.Error);

            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task ReadUsers(BiometricDevice device)
    {
        _busy = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            _deviceUsers = await scope.ServiceProvider.GetRequiredService<IAttendanceSyncService>()
                .ReadDeviceUsersAsync(device.Id);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task Assign(string deviceUserId, int? employeeId)
    {
        _assign[deviceUserId] = employeeId;
        if (employeeId is null) return;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var moved = await scope.ServiceProvider.GetRequiredService<IAttendanceService>()
                .AssignUnmatchedAsync(deviceUserId, employeeId.Value);

            Snackbar.Add($"Matched {moved} punch(es) and rebuilt their days.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
