@page "/hr/me"
@attribute [Authorize(Policy = HrPermissions.AttendanceViewOwn)]
@layout HrLayout
@rendermode InteractiveServer
@using Hr.Infrastructure.Attendance
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthState

<PageTitle>My Attendance</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">My Attendance</MudText>

@if (_employee is null)
{
    <MudAlert Severity="Severity.Info">
        Your login isn't linked to an employee record yet. Ask HR to link it so your
        attendance and leave show up here.
    </MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4">
        <MudGrid Spacing="2">
            <MudItem xs="6" md="3">
                <MudSelect T="int" Value="_month" ValueChanged="OnMonthChanged" Label="Month"
                           Margin="Margin.Dense">
                    @for (var m = 1; m <= 12; m++)
                    {
                        var month = m;
                        <MudSelectItem T="int" Value="@month">
                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" md="3">
                <MudSelect T="int" Value="_year" ValueChanged="OnYearChanged" Label="Year"
                           Margin="Margin.Dense">
                    @for (var y = DateTime.Today.Year - 3; y <= DateTime.Today.Year; y++)
                    {
                        var year = y;
                        <MudSelectItem T="int" Value="@year">@year</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle1" Class="mb-2">
                    @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(_month) @_year
                </MudText>
                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr><th>Date</th><th>Status</th><th>In</th><th>Out</th><th>Worked</th><th>Late</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _days)
                        {
                            <tr>
                                <td>@d.Date.ToString("ddd dd")</td>
                                <td><AttendanceChip Status="@d.Status" /></td>
                                <td>@(d.FirstIn?.ToString("HH\\:mm") ?? "—")</td>
                                <td>@(d.LastOut?.ToString("HH\\:mm") ?? "—")</td>
                                <td>@(d.WorkedMinutes > 0 ? $"{d.WorkedMinutes / 60}h {d.WorkedMinutes % 60:00}m" : "")</td>
                                <td>@(d.LateMinutes > 0 ? $"{d.LateMinutes}m" : "")</td>
                            </tr>
                        }
                        @if (_days.Count == 0)
                        {
                            <tr><td colspan="6" class="mud-text-secondary">Nothing recorded this month.</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4 mb-3">
                <MudText Typo="Typo.subtitle1" Class="mb-2">This month</MudText>
                <MudSimpleTable Dense="true">
                    <tbody>
                        <tr><td>Present</td><td style="text-align:right">@Count(AttendanceStatus.Present)</td></tr>
                        <tr><td>Late</td><td style="text-align:right">@Count(AttendanceStatus.Late)</td></tr>
                        <tr><td>Absent</td><td style="text-align:right">@Count(AttendanceStatus.Absent)</td></tr>
                        <tr><td>On leave</td><td style="text-align:right">@Count(AttendanceStatus.OnLeave)</td></tr>
                        <tr><td>Overtime</td>
                            <td style="text-align:right">@((_days.Sum(d => d.OvertimeMinutes) / 60.0).ToString("0.#"))h</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>

            <MudPaper Class="pa-4">
                <MudText Typo="Typo.subtitle1" Class="mb-2">Leave balances @DateTime.Today.Year</MudText>
                <MudSimpleTable Dense="true">
                    <thead><tr><th>Type</th><th style="text-align:right">Left</th></tr></thead>
                    <tbody>
                        @foreach (var b in _balances)
                        {
                            <tr>
                                <td>@b.LeaveType.Name</td>
                                <td style="text-align:right"><b>@b.Available.ToString("0.#")</b></td>
                            </tr>
                        }
                        @if (_balances.Count == 0)
                        {
                            <tr><td colspan="2" class="mud-text-secondary">
                                No balances opened for this year yet.
                            </td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private Employee? _employee;
    private List<AttendanceDay> _days = [];
    private List<LeaveBalance> _balances = [];

    private int _year = DateTime.Today.Year;
    private int _month = DateTime.Today.Month;

    private int Count(AttendanceStatus s) => _days.Count(d => d.Status == s);

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        using var scope = ScopeFactory.CreateScope();
        _employee = await scope.ServiceProvider.GetRequiredService<IEmployeeService>()
            .GetByUserIdAsync(userId);

        await LoadAsync();
    }

    private async Task OnMonthChanged(int m) { _month = m; await LoadAsync(); }
    private async Task OnYearChanged(int y) { _year = y; await LoadAsync(); }

    private async Task LoadAsync()
    {
        if (_employee is null) return;

        var from = new DateOnly(_year, _month, 1);
        var to = from.AddMonths(1).AddDays(-1);

        using var scope = ScopeFactory.CreateScope();
        _days = await scope.ServiceProvider.GetRequiredService<IAttendanceService>()
            .GetForEmployeeAsync(_employee.Id, from, to);
        _balances = await scope.ServiceProvider.GetRequiredService<ILeaveService>()
            .GetBalancesAsync(_employee.Id, DateTime.Today.Year);

        StateHasChanged();
    }
}
