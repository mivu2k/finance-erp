<MudNavMenu>
    <MudNavLink Href="/hr" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">
        Dashboard
    </MudNavLink>

    <AuthorizeView Policy="@HrPermissions.AttendanceViewOwn" Context="me">
        <MudNavLink Href="/hr/me" Icon="@Icons.Material.Filled.Person">My Attendance</MudNavLink>
    </AuthorizeView>

    <AuthorizeView Policy="@HrPermissions.EmployeesView">
        <MudNavLink Href="/hr/employees" Icon="@Icons.Material.Filled.Groups">Employees</MudNavLink>
    </AuthorizeView>

    <AuthorizeView Policy="@HrPermissions.AttendanceViewAll" Context="att">
        <MudNavGroup Title="Attendance" Icon="@Icons.Material.Filled.Fingerprint" Expanded="true">
            <MudNavLink Href="/hr/attendance" Icon="@Icons.Material.Filled.Today">
                Daily Register
            </MudNavLink>
            <MudNavLink Href="/hr/attendance/monthly" Icon="@Icons.Material.Filled.CalendarMonth">
                Monthly Report
            </MudNavLink>
            <AuthorizeView Policy="@HrPermissions.DevicesManage" Context="dev">
                <MudNavLink Href="/hr/stations" Icon="@Icons.Material.Filled.PointOfSale">
                    Attendance Stations
                </MudNavLink>
            </AuthorizeView>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Policy="@HrPermissions.AttendanceViewOwn" Context="mc">
        <MudNavLink Href="/hr/my-code" Icon="@Icons.Material.Filled.QrCode2">My Attendance Code</MudNavLink>
    </AuthorizeView>

    <AuthorizeView Policy="@HrPermissions.LeaveViewAll" Context="lv">
        <MudNavGroup Title="Leave" Icon="@Icons.Material.Filled.EventBusy" Expanded="true">
            <MudNavLink Href="/hr/leave" Icon="@Icons.Material.Filled.List">Requests</MudNavLink>
            <AuthorizeView Policy="@HrPermissions.LeaveManage" Context="lm">
                <MudNavLink Href="/hr/attendance/setup" Icon="@Icons.Material.Filled.Tune">
                    Shifts, Holidays &amp; Types
                </MudNavLink>
            </AuthorizeView>
        </MudNavGroup>
    </AuthorizeView>

    <AuthorizeView Policy="@HrPermissions.ReportsView" Context="rep">
        <MudNavLink Href="/hr/documents" Icon="@Icons.Material.Filled.Description">
            Expiring Documents
        </MudNavLink>
    </AuthorizeView>

    <AuthorizeView Policy="@HrPermissions.CatalogManage" Context="cat">
        <MudNavLink Href="/hr/setup" Icon="@Icons.Material.Filled.Settings">
            Departments &amp; Designations
        </MudNavLink>
    </AuthorizeView>
</MudNavMenu>
